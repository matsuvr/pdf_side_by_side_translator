{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "isolated-build-environment",
      "hidden": true,
      "environment": {
        "CPATH": null,
        "C_INCLUDE_PATH": null,
        "CPLUS_INCLUDE_PATH": null,
        "OBJC_INCLUDE_PATH": null,
        "LIBRARY_PATH": null,
        "CFLAGS": null,
        "CXXFLAGS": null,
        "LDFLAGS": null,
        "SDKROOT": null
      }
    },
    {
      "name": "windows-x64-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OPT_TARGET": "windows-x64-release"
      },
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows.cmake",
      "inherits": "isolated-build-environment"
    },
    {
      "name": "windows-x64-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OPT_TARGET": "windows-x64-debug"
      },
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows.cmake",
      "inherits": "isolated-build-environment"
    },
    {
      "name": "macos-arm64-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-arm64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OPT_TARGET": "macos-arm64-release",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0"
      },
      "toolchainFile": "${sourceDir}/cmake/toolchains/macos.cmake",
      "inherits": "isolated-build-environment"
    },
    {
      "name": "macos-arm64-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-arm64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OPT_TARGET": "macos-arm64-debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0"
      },
      "toolchainFile": "${sourceDir}/cmake/toolchains/macos.cmake",
      "inherits": "isolated-build-environment"
    },
    {
      "name": "macos-x64-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OPT_TARGET": "macos-x64-release",
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0"
      },
      "toolchainFile": "${sourceDir}/cmake/toolchains/macos.cmake",
      "inherits": "isolated-build-environment"
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "jobs": 4
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug",
      "jobs": 4
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64-release",
      "jobs": 4
    },
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug",
      "jobs": 4
    },
    {
      "name": "macos-x64-release",
      "configurePreset": "macos-x64-release",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-x64-release",
      "configurePreset": "macos-x64-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
