<Window x:Class="OfflinePdf.ViewerWindow" Title="Offline PDF Translator"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="Root" RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
       KeyboardAcceleratorPlacementMode="Hidden">
  <Grid.Resources>
   <Style x:Key="ReadingTextStyle" TargetType="TextBox">
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="IsSpellCheckEnabled" Value="False"/>
    <Setter Property="AcceptsReturn" Value="True"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
   </Style>
  </Grid.Resources>
  <MenuBar x:Name="Menus" AutomationProperties.Name="メインメニュー">
   <MenuBarItem Title="ファイル">
    <MenuFlyoutItem Text="PDFを開く…" Click="Pick" KeyboardAcceleratorTextOverride="Ctrl+O"/>
    <MenuFlyoutSubItem x:Name="Recent" Text="この起動中に開いたPDF" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="CloseItem" Text="文書を閉じる" Click="CloseDocument" KeyboardAcceleratorTextOverride="Ctrl+W" IsEnabled="False"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem Text="終了" Click="Quit" KeyboardAcceleratorTextOverride="Ctrl+Q"/>
   </MenuBarItem>
   <MenuBarItem Title="選択・コピー">
    <MenuFlyoutItem Text="コピー" Click="CopySelection" KeyboardAcceleratorTextOverride="Ctrl+C"/>
    <MenuFlyoutItem Text="全選択" Click="SelectAll" KeyboardAcceleratorTextOverride="Ctrl+A"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="CopySourceItem" Text="ページの原文をコピー" Click="CopySource" IsEnabled="False"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="FindItem" Text="PDF内を検索…" Click="ShowFind" KeyboardAcceleratorTextOverride="Ctrl+F" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="FindNextItem" Text="次の検索結果" Click="FindNext" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="FindPreviousItem" Text="前の検索結果" Click="FindPrevious" IsEnabled="False"/>
   </MenuBarItem>
   <MenuBarItem Title="表示">
    <MenuFlyoutItem x:Name="FitWidthItem" Text="幅に合わせる" Click="FitWidth" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="FitPageItem" Text="ページ全体" Click="FitPage" KeyboardAcceleratorTextOverride="Ctrl+0" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="RotateLeftItem" Text="左回転" Click="RotateLeft" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="RotateRightItem" Text="右回転" Click="RotateRight" IsEnabled="False"/>
    <MenuFlyoutItem Text="左右を均等にする" Click="EqualPanes"/>
    <MenuFlyoutItem Text="訳文の文字サイズ…" Click="ChangeTextSize"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="PageItem" Text="ページ番号へ" Click="FocusPage" KeyboardAcceleratorTextOverride="Ctrl+G" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="PreviousItem" Text="前のページ" Click="Prev" KeyboardAcceleratorTextOverride="Ctrl+[" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="NextItem" Text="次のページ" Click="Forward" KeyboardAcceleratorTextOverride="Ctrl+]" IsEnabled="False"/>
   </MenuBarItem>
   <MenuBarItem Title="翻訳">
    <ToggleMenuFlyoutItem x:Name="AutoTranslate" Text="現在ページを自動翻訳" IsChecked="True" Click="SetTranslationOptions"/>
    <MenuFlyoutSeparator/>
    <RadioMenuFlyoutItem x:Name="PlainStyle" GroupName="TranslationStyle" Text="標準文体" IsChecked="True" Click="SetTranslationOptions"/>
    <RadioMenuFlyoutItem x:Name="EasyStyle" GroupName="TranslationStyle" Text="やさしい文体" Click="SetTranslationOptions"/>
   </MenuBarItem>
   <MenuBarItem Title="モデル設定">
    <MenuFlyoutItem Text="モデルを選択…" Click="PickModel" KeyboardAcceleratorTextOverride="Ctrl+,"/>
   </MenuBarItem>
   <MenuBarItem Title="ヘルプ">
    <MenuFlyoutItem Text="操作方法" Click="ShowHelp"/>
    <MenuFlyoutItem Text="診断情報をコピー…" Click="ShowDiagnostics"/>
    <MenuFlyoutItem Text="ライセンス…" Click="ShowLicenses"/>
    <MenuFlyoutItem Text="このアプリについて" Click="ShowAbout"/>
   </MenuBarItem>
  </MenuBar>
  <Button Grid.Row="1" Margin="8,3,8,5" Content="PDFを開く" Click="Pick"/>
  <StackPanel x:Name="SearchBar" Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="8,0,8,6" Visibility="Collapsed" KeyDown="SearchEntered">
   <TextBox x:Name="Query" Width="180" PlaceholderText="PDF内を検索" AutomationProperties.Name="PDFの検索語"/>
   <Button Content="前へ" Click="FindPrevious" AutomationProperties.Name="前の検索結果"/>
   <Button Content="次へ" Click="FindNext" AutomationProperties.Name="次の検索結果"/>
   <CheckBox x:Name="CaseSensitive" Content="大文字・小文字を区別"/>
   <Button Content="×" Click="HideFind" AutomationProperties.Name="検索を閉じる"/>
  </StackPanel>
  <Grid x:Name="Panes" Grid.Row="3" ColumnDefinitions="*,6,*" RowDefinitions="Auto,*">
   <ScrollViewer x:Name="OriginalHeader" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
       VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" SizeChanged="HeaderResized">
    <StackPanel Orientation="Horizontal" Margin="8,3,4,4" Spacing="4">
     <TextBlock Text="原文 —" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
     <TextBox x:Name="PageNumber" Width="44" MinWidth="0" Padding="4,3" AutomationProperties.Name="ページ番号" KeyDown="PageEntered" IsEnabled="False" TextAlignment="Center"/>
     <TextBlock x:Name="PageCount" VerticalAlignment="Center" Margin="0,0,4,0"/>
     <Button x:Name="Smaller" Width="29" MinWidth="0" Padding="0" Content="−" Click="ZoomOut" AutomationProperties.Name="縮小" IsEnabled="False"/>
     <TextBox x:Name="ZoomPercent" Width="60" MinWidth="0" Padding="4,3" TextAlignment="Center" KeyDown="ZoomEntered" LostFocus="ZoomLostFocus" AutomationProperties.Name="PDFの倍率" IsEnabled="False"/>
     <Button x:Name="Larger" Width="29" MinWidth="0" Padding="0" Content="＋" Click="ZoomIn" AutomationProperties.Name="拡大" IsEnabled="False"/>
     <ComboBox x:Name="ZoomPreset" Width="128" MinWidth="0" SelectedIndex="0" SelectionChanged="ZoomPresetChanged" AutomationProperties.Name="ページの表示方法" IsEnabled="False">
      <ComboBoxItem Content="ページ全体"/>
      <ComboBoxItem Content="幅に合わせる"/>
      <ComboBoxItem Content="倍率指定"/>
     </ComboBox>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
    <Button x:Name="Previous" Content="‹" VerticalAlignment="Center" Padding="5,12" AutomationProperties.Name="前のページ" Click="Prev" IsEnabled="False"/>
    <ScrollViewer x:Name="PaperScroll" Grid.Column="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
        Background="{ThemeResource LayerFillColorDefaultBrush}" SizeChanged="PaperViewportChanged">
     <Canvas x:Name="PaperCanvas" Margin="8">
      <Image x:Name="Paper" Stretch="Fill" RenderTransformOrigin="0.5,0.5" AutomationProperties.Name="現在のPDFページ">
       <Image.RenderTransform><RotateTransform x:Name="PaperAngle"/></Image.RenderTransform>
      </Image>
     </Canvas>
    </ScrollViewer>
    <Button x:Name="Next" Grid.Column="2" Content="›" VerticalAlignment="Center" Padding="5,12" AutomationProperties.Name="次のページ" Click="Forward" IsEnabled="False"/>
   </Grid>
   <Thumb x:Name="Splitter" Grid.Column="1" Grid.RowSpan="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
       DragDelta="ResizePanes" AutomationProperties.Name="原文と訳文の表示幅">
    <Thumb.Template>
     <ControlTemplate><Border BorderThickness="1,0,0,0" Background="Transparent" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"/></ControlTemplate>
    </Thumb.Template>
   </Thumb>
   <TextBlock x:Name="TranslationHeading" Grid.Column="2" Text="訳文" Margin="8,3,8,3" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
   <TextBox x:Name="Translation" Grid.Row="1" Grid.Column="2" Style="{StaticResource ReadingTextStyle}"
        AutomationProperties.Name="現在ページの日本語訳"/>
  </Grid>
  <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16" Margin="8,3">
   <TextBlock x:Name="Status" Text="PDFを開いてください。" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock x:Name="CpuStatus" Grid.Column="1"/>
   <TextBlock x:Name="TranslationStatus" Grid.Column="2"/>
  </Grid>
 </Grid>
</Window>
