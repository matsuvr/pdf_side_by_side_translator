+// ============================================================================
+// x86 AVX2 / AVX-VNNI 4-byte-interleaved Q4_K & Q6_K repack kernels
+// (8-row panels x 4-byte interleave: zero-shuffle vpdpbusd dot products)
+// ============================================================================
+
+#if defined(__AVX2__) && defined(__FMA__) && defined(__F16C__)
+static inline __m256i ggml_x86_dpbusd_epi32(__m256i acc, __m256i u8, __m256i i8) {
+#if defined(__AVXVNNI__)
+    return _mm256_dpbusd_epi32(acc, u8, i8);
+#else
+    __m256i p16 = _mm256_maddubs_epi16(u8, i8);
+    __m256i p32 = _mm256_madd_epi16(p16, _mm256_set1_epi16(1));
+    return _mm256_add_epi32(acc, p32);
+#endif
+}
+
+static inline void ggml_unpack_q4k_scales_8x4(const uint8_t * p, __m256i & v_s32, __m256i & v_m32) {
+    uint32_t w0, w1, w2;
+    memcpy(&w0, p + 0, 4);
+    memcpy(&w1, p + 4, 4);
+    memcpy(&w2, p + 8, 4);
+    const uint32_t s_lo = w0 & 0x3f3f3f3fu;
+    const uint32_t s_hi = (w2 & 0x0f0f0f0fu) | ((w0 >> 2) & 0x30303030u);
+    const uint32_t m_lo = w1 & 0x3f3f3f3fu;
+    const uint32_t m_hi = ((w2 >> 4) & 0x0f0f0f0fu) | ((w1 >> 2) & 0x30303030u);
+    const __m128i sc8 = _mm_set_epi32((int) m_hi, (int) m_lo, (int) s_hi, (int) s_lo);
+    v_s32 = _mm256_cvtepu8_epi32(sc8);
+    v_m32 = _mm256_cvtepu8_epi32(_mm_srli_si128(sc8, 8));
+}
+#endif
+
+extern "C" void ggml_quantize_mat_q8_K_4x4_vnni(const float * GGML_RESTRICT x, void * GGML_RESTRICT vy, int64_t k) {
+#if defined(__AVX2__)
+    assert(QK_K == 256);
+    assert(k % QK_K == 0);
+    const int nb = (int) (k / QK_K);
+    block_q8_Kx4 * GGML_RESTRICT y = (block_q8_Kx4 *) vy;
+
+    const __m256 sign_mask = _mm256_set1_ps(-0.0f);
+    const __m128i ones_i8  = _mm_set1_epi8(1);
+    const __m128i ones_i16 = _mm_set1_epi16(1);
+
+    alignas(32) int8_t qtmp[4][256];
+
+    for (int i = 0; i < nb; ++i) {
+        for (int r = 0; r < 4; ++r) {
+            const float * xr = x + (int64_t) r * k + (int64_t) i * QK_K;
+
+            __m256 v_max_abs = _mm256_setzero_ps();
+            for (int j = 0; j < QK_K; j += 8) {
+                __m256 vx = _mm256_loadu_ps(xr + j);
+                v_max_abs = _mm256_max_ps(v_max_abs, _mm256_andnot_ps(sign_mask, vx));
+            }
+            __m128 m128 = _mm_max_ps(_mm256_castps256_ps128(v_max_abs), _mm256_extractf128_ps(v_max_abs, 1));
+            m128 = _mm_max_ps(m128, _mm_movehl_ps(m128, m128));
+            m128 = _mm_max_ss(m128, _mm_shuffle_ps(m128, m128, 1));
+            float amax = _mm_cvtss_f32(m128);
+
+            if (amax == 0.0f) {
+                y[i].d[r] = 0.0f;
+                memset(qtmp[r], 0, QK_K);
+                continue;
+            }
+
+            float max_signed = amax;
+            for (int j = 0; j < QK_K; ++j) {
+                if (fabsf(xr[j]) == amax) {
+                    max_signed = xr[j];
+                    break;
+                }
+            }
+            const float iscale = -127.0f / max_signed;
+            y[i].d[r] = 1.0f / iscale;
+            const __m256 v_isc = _mm256_set1_ps(iscale);
+
+            for (int j = 0; j < QK_K; j += 32) {
+                __m256i q0 = _mm256_cvtps_epi32(_mm256_round_ps(_mm256_mul_ps(_mm256_loadu_ps(xr + j +  0), v_isc), _MM_FROUND_TO_NEAREST_INT | _MM_FROUND_NO_EXC));
+                __m256i q1 = _mm256_cvtps_epi32(_mm256_round_ps(_mm256_mul_ps(_mm256_loadu_ps(xr + j +  8), v_isc), _MM_FROUND_TO_NEAREST_INT | _MM_FROUND_NO_EXC));
+                __m256i q2 = _mm256_cvtps_epi32(_mm256_round_ps(_mm256_mul_ps(_mm256_loadu_ps(xr + j + 16), v_isc), _MM_FROUND_TO_NEAREST_INT | _MM_FROUND_NO_EXC));
+                __m256i q3 = _mm256_cvtps_epi32(_mm256_round_ps(_mm256_mul_ps(_mm256_loadu_ps(xr + j + 24), v_isc), _MM_FROUND_TO_NEAREST_INT | _MM_FROUND_NO_EXC));
+
+                __m256i p01 = _mm256_packs_epi32(q0, q1);
+                __m256i p23 = _mm256_packs_epi32(q2, q3);
+                p01 = _mm256_permute4x64_epi64(p01, 0xD8);
+                p23 = _mm256_permute4x64_epi64(p23, 0xD8);
+                __m256i p8 = _mm256_packs_epi16(p01, p23);
+                p8 = _mm256_permute4x64_epi64(p8, 0xD8);
+                _mm256_store_si256((__m256i *) (qtmp[r] + j), p8);
+            }
+        }
+
+        for (int k_grp = 0; k_grp < 16; ++k_grp) {
+            const int sb = k_grp >> 2;
+            const int g  = k_grp & 3;
+            __m128i r0 = _mm_load_si128((const __m128i *) (qtmp[0] + k_grp * 16));
+            __m128i r1 = _mm_load_si128((const __m128i *) (qtmp[1] + k_grp * 16));
+            __m128i r2 = _mm_load_si128((const __m128i *) (qtmp[2] + k_grp * 16));
+            __m128i r3 = _mm_load_si128((const __m128i *) (qtmp[3] + k_grp * 16));
+
+            auto sum16_i8 = [&](__m128i v) -> int16_t {
+                __m128i s16 = _mm_maddubs_epi16(ones_i8, v);
+                __m128i s32 = _mm_madd_epi16(s16, ones_i16);
+                s32 = _mm_add_epi32(s32, _mm_srli_si128(s32, 8));
+                s32 = _mm_add_epi32(s32, _mm_srli_si128(s32, 4));
+                return (int16_t) _mm_cvtsi128_si32(s32);
+            };
+
+            y[i].bsums[sb * 16 + 0 * 4 + g] = sum16_i8(r0);
+            y[i].bsums[sb * 16 + 1 * 4 + g] = sum16_i8(r1);
+            y[i].bsums[sb * 16 + 2 * 4 + g] = sum16_i8(r2);
+            y[i].bsums[sb * 16 + 3 * 4 + g] = sum16_i8(r3);
+
+            __m128i t0 = _mm_unpacklo_epi32(r0, r1);
+            __m128i t1 = _mm_unpackhi_epi32(r0, r1);
+            __m128i t2 = _mm_unpacklo_epi32(r2, r3);
+            __m128i t3 = _mm_unpackhi_epi32(r2, r3);
+
+            int8_t * dst = y[i].qs + k_grp * 64;
+            _mm_storeu_si128((__m128i *) (dst +  0), _mm_unpacklo_epi64(t0, t2));
+            _mm_storeu_si128((__m128i *) (dst + 16), _mm_unpackhi_epi64(t0, t2));
+            _mm_storeu_si128((__m128i *) (dst + 32), _mm_unpacklo_epi64(t1, t3));
+            _mm_storeu_si128((__m128i *) (dst + 48), _mm_unpackhi_epi64(t1, t3));
+        }
+    }
+#else
+    ggml_quantize_mat_q8_K_4x4_generic(x, vy, k);
+#endif
+}
+
+extern "C" void ggml_gemv_q4_K_8x4_q8_K_vnni(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+#if defined(__AVX2__) && defined(__FMA__) && defined(__F16C__)
+    const int nb = n / QK_K;
+    assert(n % QK_K == 0);
+    assert(nc % 8 == 0);
+
+    const __m256i m4b = _mm256_set1_epi8(0x0F);
+    const block_q4_Kx8 * b_ptr_start = (const block_q4_Kx8 *) vx;
+    const block_q8_K   * a_ptr_start = (const block_q8_K   *) vy;
+
+    for (int y = 0; y < nr; ++y) {
+        const block_q8_K * a_ptr = a_ptr_start + (int64_t) y * nb;
+        float * s_row = s + (int64_t) y * bs;
+
+        const int nx = nc / 8;
+        int x = 0;
+        // 2-panel (16 rows) unrolled GEMV: halves activation broadcasts & doubles DRAM MLP
+        for (; x + 1 < nx; x += 2) {
+            const block_q4_Kx8 * b0 = b_ptr_start + (int64_t) (x + 0) * nb;
+            const block_q4_Kx8 * b1 = b_ptr_start + (int64_t) (x + 1) * nb;
+            __m256 acc0 = _mm256_setzero_ps();
+            __m256 acc1 = _mm256_setzero_ps();
+
+            for (int b = 0; b < nb; ++b) {
+                if (b + 1 < nb) {
+                    _mm_prefetch((const char *) (b0 + b + 1),       _MM_HINT_T0);
+                    _mm_prefetch((const char *) (b0 + b + 1) + 512, _MM_HINT_T0);
+                    _mm_prefetch((const char *) (b1 + b + 1),       _MM_HINT_T0);
+                    _mm_prefetch((const char *) (b1 + b + 1) + 512, _MM_HINT_T0);
+                }
+
+                const __m256 d_a = _mm256_set1_ps(a_ptr[b].d);
+                const __m256 dw0 = _mm256_mul_ps(_mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) b0[b].d)),    d_a);
+                const __m256 dm0 = _mm256_mul_ps(_mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) b0[b].dmin)), d_a);
+                const __m256 dw1 = _mm256_mul_ps(_mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) b1[b].d)),    d_a);
+                const __m256 dm1 = _mm256_mul_ps(_mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) b1[b].dmin)), d_a);
+
+                __m256i iacc0 = _mm256_setzero_si256(), imin0 = _mm256_setzero_si256();
+                __m256i iacc1 = _mm256_setzero_si256(), imin1 = _mm256_setzero_si256();
+
+                const int8_t  * a_qs = a_ptr[b].qs;
+                const int16_t * a_bs = a_ptr[b].bsums;
+
+                for (int sb = 0; sb < 4; ++sb) {
+                    __m256i alo0 = _mm256_setzero_si256(), ahi0 = _mm256_setzero_si256();
+                    __m256i alo1 = _mm256_setzero_si256(), ahi1 = _mm256_setzero_si256();
+
+                    const uint8_t * qs0  = b0[b].qs + sb * 256;
+                    const uint8_t * qs1  = b1[b].qs + sb * 256;
+                    const int32_t * a_lo = (const int32_t *) (a_qs + sb * 64);
+                    const int32_t * a_hi = (const int32_t *) (a_qs + sb * 64 + 32);
+
+                    for (int c = 0; c < 8; ++c) {
+                        const __m256i va_lo = _mm256_set1_epi32(a_lo[c]);
+                        const __m256i va_hi = _mm256_set1_epi32(a_hi[c]);
+
+                        const __m256i r0 = _mm256_loadu_si256((const __m256i *) (qs0 + c * 32));
+                        alo0 = ggml_x86_dpbusd_epi32(alo0, _mm256_and_si256(r0, m4b), va_lo);
+                        ahi0 = ggml_x86_dpbusd_epi32(ahi0, _mm256_and_si256(_mm256_srli_epi16(r0, 4), m4b), va_hi);
+
+                        const __m256i r1 = _mm256_loadu_si256((const __m256i *) (qs1 + c * 32));
+                        alo1 = ggml_x86_dpbusd_epi32(alo1, _mm256_and_si256(r1, m4b), va_lo);
+                        ahi1 = ggml_x86_dpbusd_epi32(ahi1, _mm256_and_si256(_mm256_srli_epi16(r1, 4), m4b), va_hi);
+                    }
+
+                    const __m256i v_bs0 = _mm256_set1_epi32((int32_t) a_bs[sb * 4 + 0] + (int32_t) a_bs[sb * 4 + 1]);
+                    const __m256i v_bs1 = _mm256_set1_epi32((int32_t) a_bs[sb * 4 + 2] + (int32_t) a_bs[sb * 4 + 3]);
+
+                    __m256i s0, m0, s1, m1;
+                    ggml_unpack_q4k_scales_8x4(b0[b].scales + sb * 24 +  0, s0, m0);
+                    ggml_unpack_q4k_scales_8x4(b0[b].scales + sb * 24 + 12, s1, m1);
+                    iacc0 = _mm256_add_epi32(iacc0, _mm256_add_epi32(_mm256_mullo_epi32(alo0, s0), _mm256_mullo_epi32(ahi0, s1)));
+                    imin0 = _mm256_add_epi32(imin0, _mm256_add_epi32(_mm256_mullo_epi32(m0, v_bs0), _mm256_mullo_epi32(m1, v_bs1)));
+
+                    ggml_unpack_q4k_scales_8x4(b1[b].scales + sb * 24 +  0, s0, m0);
+                    ggml_unpack_q4k_scales_8x4(b1[b].scales + sb * 24 + 12, s1, m1);
+                    iacc1 = _mm256_add_epi32(iacc1, _mm256_add_epi32(_mm256_mullo_epi32(alo1, s0), _mm256_mullo_epi32(ahi1, s1)));
+                    imin1 = _mm256_add_epi32(imin1, _mm256_add_epi32(_mm256_mullo_epi32(m0, v_bs0), _mm256_mullo_epi32(m1, v_bs1)));
+                }
+
+                acc0 = _mm256_fmadd_ps(_mm256_cvtepi32_ps(iacc0), dw0, acc0);
+                acc0 = _mm256_fnmadd_ps(_mm256_cvtepi32_ps(imin0), dm0, acc0);
+                acc1 = _mm256_fmadd_ps(_mm256_cvtepi32_ps(iacc1), dw1, acc1);
+                acc1 = _mm256_fnmadd_ps(_mm256_cvtepi32_ps(imin1), dm1, acc1);
+            }
+
+            _mm256_storeu_ps(s_row + (x + 0) * 8, acc0);
+            _mm256_storeu_ps(s_row + (x + 1) * 8, acc1);
+        }
+
+        for (; x < nx; ++x) {
+            const block_q4_Kx8 * b_ptr = b_ptr_start + (int64_t) x * nb;
+            __m256 acc_row = _mm256_setzero_ps();
+
+            for (int b = 0; b < nb; ++b) {
+                if (b + 1 < nb) {
+                    _mm_prefetch((const char *) (b_ptr + b + 1), _MM_HINT_T0);
+                    _mm_prefetch((const char *) (b_ptr + b + 1) + 512, _MM_HINT_T0);
+                }
+
+                const __m256 d_a    = _mm256_set1_ps(a_ptr[b].d);
+                const __m256 d_w    = _mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) b_ptr[b].d));
+                const __m256 dmin_w = _mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) b_ptr[b].dmin));
+
+                __m256i iacc_b     = _mm256_setzero_si256();
+                __m256i iacc_min_b = _mm256_setzero_si256();
+
+                const int8_t  * a_qs = a_ptr[b].qs;
+                const int16_t * a_bs = a_ptr[b].bsums;
+
+                for (int sb = 0; sb < 4; ++sb) {
+                    __m256i v_s0, v_m0, v_s1, v_m1;
+                    ggml_unpack_q4k_scales_8x4(b_ptr[b].scales + sb * 24 +  0, v_s0, v_m0);
+                    ggml_unpack_q4k_scales_8x4(b_ptr[b].scales + sb * 24 + 12, v_s1, v_m1);
+
+                    __m256i acc_lo = _mm256_setzero_si256();
+                    __m256i acc_hi = _mm256_setzero_si256();
+
+                    const uint8_t * qs_sb = b_ptr[b].qs + sb * 256;
+                    const int32_t * a_lo  = (const int32_t *) (a_qs + sb * 64);
+                    const int32_t * a_hi  = (const int32_t *) (a_qs + sb * 64 + 32);
+
+                    for (int c = 0; c < 8; ++c) {
+                        const __m256i raw  = _mm256_loadu_si256((const __m256i *) (qs_sb + c * 32));
+                        const __m256i q_lo = _mm256_and_si256(raw, m4b);
+                        const __m256i q_hi = _mm256_and_si256(_mm256_srli_epi16(raw, 4), m4b);
+
+                        acc_lo = ggml_x86_dpbusd_epi32(acc_lo, q_lo, _mm256_set1_epi32(a_lo[c]));
+                        acc_hi = ggml_x86_dpbusd_epi32(acc_hi, q_hi, _mm256_set1_epi32(a_hi[c]));
+                    }
+
+                    iacc_b = _mm256_add_epi32(iacc_b, _mm256_mullo_epi32(acc_lo, v_s0));
+                    iacc_b = _mm256_add_epi32(iacc_b, _mm256_mullo_epi32(acc_hi, v_s1));
+
+                    const int32_t bsum0 = (int32_t) a_bs[sb * 4 + 0] + (int32_t) a_bs[sb * 4 + 1];
+                    const int32_t bsum1 = (int32_t) a_bs[sb * 4 + 2] + (int32_t) a_bs[sb * 4 + 3];
+                    iacc_min_b = _mm256_add_epi32(iacc_min_b, _mm256_mullo_epi32(v_m0, _mm256_set1_epi32(bsum0)));
+                    iacc_min_b = _mm256_add_epi32(iacc_min_b, _mm256_mullo_epi32(v_m1, _mm256_set1_epi32(bsum1)));
+                }
+
+                acc_row = _mm256_fmadd_ps(_mm256_cvtepi32_ps(iacc_b),     _mm256_mul_ps(d_w,    d_a), acc_row);
+                acc_row = _mm256_fnmadd_ps(_mm256_cvtepi32_ps(iacc_min_b), _mm256_mul_ps(dmin_w, d_a), acc_row);
+            }
+
+            _mm256_storeu_ps(s_row + x * 8, acc_row);
+        }
+    }
+#else
+    ggml_gemv_q4_K_8x4_q8_K_generic(n, s, bs, vx, vy, nr, nc);
+#endif
+}
+
+extern "C" void ggml_gemm_q4_K_8x4_q8_K_vnni(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, const void * GGML_RESTRICT vy, int nr, int nc) {
+#if defined(__AVX2__) && defined(__FMA__) && defined(__F16C__)
+    const int nb = n / QK_K;
+    assert(n % QK_K == 0);
+    assert(nr % 4 == 0);
+    assert(nc % 8 == 0);
+
+    const __m256i m4b = _mm256_set1_epi8(0x0F);
+    const block_q4_Kx8 * b_ptr_start = (const block_q4_Kx8 *) vx;
+    const block_q8_Kx4 * a_ptr_start = (const block_q8_Kx4 *) vy;
+
+    const int ny = nr / 4;
+    const int nx = nc / 8;
+    constexpr int Y_TILE = 16; // 64 tokens per L2 tile
+
+    for (int y0 = 0; y0 < ny; y0 += Y_TILE) {
+        const int y1 = (y0 + Y_TILE < ny) ? (y0 + Y_TILE) : ny;
+
+        for (int x = 0; x < nx; ++x) {
+            const block_q4_Kx8 * b_ptr = b_ptr_start + (int64_t) x * nb;
+
+            int y = y0;
+            // 8-token unrolled path: reuses unpacked Q4_K weights & scales 2x
+            for (; y + 1 < y1; y += 2) {
+                const block_q8_Kx4 * a0_ptr = a_ptr_start + (int64_t) (y + 0) * nb;
+                const block_q8_Kx4 * a1_ptr = a_ptr_start + (int64_t) (y + 1) * nb;
+
+                __m256 acc[8];
+                for (int r = 0; r < 8; ++r) acc[r] = _mm256_setzero_ps();
+
+                for (int b = 0; b < nb; ++b) {
+                    const __m256 d_w    = _mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) b_ptr[b].d));
+                    const __m256 dmin_w = _mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) b_ptr[b].dmin));
+
+                    __m256i iacc[8], imin[8];
+                    for (int r = 0; r < 8; ++r) {
+                        iacc[r] = _mm256_setzero_si256();
+                        imin[r] = _mm256_setzero_si256();
+                    }
+
+                    const int8_t  * a0_qs = a0_ptr[b].qs;
+                    const int8_t  * a1_qs = a1_ptr[b].qs;
+                    const int16_t * a0_bs = a0_ptr[b].bsums;
+                    const int16_t * a1_bs = a1_ptr[b].bsums;
+
+                    for (int sb = 0; sb < 4; ++sb) {
+                        __m256i v_s0, v_m0, v_s1, v_m1;
+                        ggml_unpack_q4k_scales_8x4(b_ptr[b].scales + sb * 24 +  0, v_s0, v_m0);
+                        ggml_unpack_q4k_scales_8x4(b_ptr[b].scales + sb * 24 + 12, v_s1, v_m1);
+
+                        const uint8_t * qs_sb = b_ptr[b].qs + sb * 256;
+
+                        {
