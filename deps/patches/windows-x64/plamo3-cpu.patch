diff --git a/ggml/src/ggml-cpu/plamo3-fattn-x86.h b/ggml/src/ggml-cpu/plamo3-fattn-x86.h
new file mode 100644
index 0000000000000000000000000000000000000000..bbdea5ee469a661f52862f7f5894116ac6c8fcda
--- /dev/null
+++ b/ggml/src/ggml-cpu/plamo3-fattn-x86.h
@@ -0,0 +1,776 @@
+#pragma once
+
+// Standalone PLaMo-3 0.8B MQA-16 (DK=DV=128, F16 KV) AVX2 Fused FlashAttention
+// Extracted from ops.cpp to minimize upstream llama.cpp merge conflicts.
+
+#if defined(__AVX2__) && defined(__FMA__) && defined(__F16C__)
+static inline __m256 ggml_fast_exp_avx2(__m256 x) {
+    const __m256 min_x   = _mm256_set1_ps(-87.33654475f);
+    const __m256 valid   = _mm256_cmp_ps(x, min_x, _CMP_GT_OQ);
+    x = _mm256_max_ps(x, min_x);
+
+    const __m256 log2e   = _mm256_set1_ps(1.44269504088896341f);
+    const __m256 ln2_hi  = _mm256_set1_ps(0.693359375f);
+    const __m256 ln2_lo  = _mm256_set1_ps(-2.12194440e-4f);
+
+    __m256 z = _mm256_mul_ps(x, log2e);
+    __m256 n = _mm256_round_ps(z, _MM_FROUND_TO_NEAREST_INT | _MM_FROUND_NO_EXC);
+    __m256 f = _mm256_fnmadd_ps(n, ln2_hi, x);
+    f        = _mm256_fnmadd_ps(n, ln2_lo, f);
+
+    const __m256 c6 = _mm256_set1_ps(1.38888889e-3f);
+    const __m256 c5 = _mm256_set1_ps(8.33333333e-3f);
+    const __m256 c4 = _mm256_set1_ps(4.16666667e-2f);
+    const __m256 c3 = _mm256_set1_ps(1.66666667e-1f);
+    const __m256 c2 = _mm256_set1_ps(5.00000000e-1f);
+    const __m256 c1 = _mm256_set1_ps(1.0f);
+
+    __m256 p = _mm256_fmadd_ps(c6, f, c5);
+    p = _mm256_fmadd_ps(p, f, c4);
+    p = _mm256_fmadd_ps(p, f, c3);
+    p = _mm256_fmadd_ps(p, f, c2);
+    p = _mm256_fmadd_ps(p, f, c1);
+    p = _mm256_fmadd_ps(p, f, c1);
+
+    __m256i ni = _mm256_add_epi32(_mm256_cvtps_epi32(n), _mm256_set1_epi32(127));
+    __m256 pow2n = _mm256_castsi256_ps(_mm256_slli_epi32(ni, 23));
+    return _mm256_and_ps(_mm256_mul_ps(p, pow2n), valid);
+}
+
+static inline float ggml_hsum256_ps_fa(__m256 v) {
+    __m128 lo = _mm256_castps256_ps128(v);
+    __m128 hi = _mm256_extractf128_ps(v, 1);
+    lo = _mm_add_ps(lo, hi);
+    lo = _mm_add_ps(lo, _mm_movehl_ps(lo, lo));
+    lo = _mm_add_ss(lo, _mm_shuffle_ps(lo, lo, 1));
+    return _mm_cvtss_f32(lo);
+}
+
+// Specialized MQA-16, DK=DV=128, F16 KV fused decode flash-attention kernel (loads/converts K and V once for all 16 query heads)
+static void ggml_compute_forward_flash_attn_ext_mqa16_d128_f16(
+        const ggml_compute_params * params,
+        ggml_tensor * dst,
+        int64_t ic_start, int64_t ic_end,
+        float * chunk_partials, int64_t partial_stride) {
+
+    const ggml_tensor * q    = dst->src[0];
+    const ggml_tensor * k    = dst->src[1];
+    const ggml_tensor * v    = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+
+    const size_t nbq2 = q->nb[2];
+    const size_t nbk1 = k->nb[1];
+    const size_t nbv1 = v->nb[1];
+
+    float scale = 1.0f;
+    memcpy(&scale, (float *) dst->op_params + 0, sizeof(float));
+
+    const bool write_partials = (chunk_partials != nullptr);
+
+    alignas(32) float Qs[16][128];
+    alignas(32) float VKQ[16][128];
+    alignas(32) float M[16];
+    alignas(32) float S[16];
+
+    const __m256 vscale = _mm256_set1_ps(scale);
+    for (int h = 0; h < 16; ++h) {
+        const float * pq = (const float *) ((const char *) q->data + h * nbq2);
+        for (int d = 0; d < 128; d += 8) {
+            _mm256_store_ps(Qs[h] + d, _mm256_mul_ps(_mm256_loadu_ps(pq + d), vscale));
+        }
+        M[h] = -INFINITY;
+        S[h] = 0.0f;
+    }
+    memset(VKQ, 0, sizeof(VKQ));
+
+    const ggml_fp16_t * mp = mask ? (const ggml_fp16_t *) mask->data : nullptr;
+    const char * k_base = (const char *) k->data;
+    const char * v_base = (const char *) v->data;
+
+    constexpr int BLOCK = 64;
+    int64_t valid_ic[BLOCK];
+    alignas(32) float valid_mv[BLOCK];
+    alignas(32) float scores[BLOCK][16];
+    alignas(32) float Kbuf[4][128];
+    alignas(32) float Vbuf[8][128];
+
+    const __m128i v_neginf_f16 = _mm_set1_epi16((short) 0xFC00);
+    const __m128i v_zero_f16   = _mm_setzero_si128();
+
+    int64_t ic = ic_start;
+    while (ic < ic_end) {
+        int cnt = 0;
+        if (mp == nullptr) {
+            int64_t take = std::min<int64_t>(BLOCK, ic_end - ic);
+            for (int i = 0; i < take; ++i) {
+                valid_ic[i] = ic + i;
+                valid_mv[i] = 0.0f;
+            }
+            cnt = (int) take;
+            ic += take;
+        } else {
+            while (ic < ic_end && cnt < BLOCK) {
+                if (ic + 8 <= ic_end && cnt + 8 <= BLOCK) {
+                    __m128i m8 = _mm_loadu_si128((const __m128i *) (mp + ic));
+                    if (_mm_movemask_epi8(_mm_cmpeq_epi16(m8, v_neginf_f16)) == 0xFFFF) {
+                        ic += 8;
+                        continue;
+                    }
+                    if (_mm_movemask_epi8(_mm_cmpeq_epi16(m8, v_zero_f16)) == 0xFFFF) {
+                        for (int i = 0; i < 8; ++i) {
+                            valid_ic[cnt] = ic + i;
+                            valid_mv[cnt] = 0.0f;
+                            ++cnt;
+                        }
+                        ic += 8;
+                        continue;
+                    }
+                }
+                const float mv = GGML_CPU_FP16_TO_FP32(mp[ic]);
+                if (mv != -INFINITY) {
+                    valid_ic[cnt] = ic;
+                    valid_mv[cnt] = mv;
+                    ++cnt;
+                }
+                ++ic;
+            }
+        }
+
+        if (cnt == 0) {
+            continue;
+        }
+
+        // 1. Compute QK^T for all 16 heads x cnt valid K tokens (loading & converting K once!)
+        int t = 0;
+        for (; t + 1 < cnt; t += 2) {
+            const ggml_fp16_t * pk0 = (const ggml_fp16_t *) (k_base + valid_ic[t + 0] * nbk1);
+            const ggml_fp16_t * pk1 = (const ggml_fp16_t *) (k_base + valid_ic[t + 1] * nbk1);
+            for (int d = 0; d < 128; d += 8) {
+                _mm256_store_ps(Kbuf[0] + d, _mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) (pk0 + d))));
+                _mm256_store_ps(Kbuf[1] + d, _mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) (pk1 + d))));
+            }
+            const float mv0 = valid_mv[t + 0];
+            const float mv1 = valid_mv[t + 1];
+
+            // 4 query heads x 2 K tokens = 8 YMM accumulators (zero spills)
+            for (int h = 0; h < 16; h += 4) {
+                __m256 a00 = _mm256_setzero_ps(), a01 = _mm256_setzero_ps();
+                __m256 a10 = _mm256_setzero_ps(), a11 = _mm256_setzero_ps();
+                __m256 a20 = _mm256_setzero_ps(), a21 = _mm256_setzero_ps();
+                __m256 a30 = _mm256_setzero_ps(), a31 = _mm256_setzero_ps();
+
+                const float * q0 = Qs[h + 0];
+                const float * q1 = Qs[h + 1];
+                const float * q2 = Qs[h + 2];
+                const float * q3 = Qs[h + 3];
+
+                for (int d = 0; d < 128; d += 8) {
+                    __m256 k0 = _mm256_load_ps(Kbuf[0] + d);
+                    __m256 k1 = _mm256_load_ps(Kbuf[1] + d);
+                    __m256 vq;
+                    vq = _mm256_load_ps(q0 + d); a00 = _mm256_fmadd_ps(vq, k0, a00); a01 = _mm256_fmadd_ps(vq, k1, a01);
+                    vq = _mm256_load_ps(q1 + d); a10 = _mm256_fmadd_ps(vq, k0, a10); a11 = _mm256_fmadd_ps(vq, k1, a11);
+                    vq = _mm256_load_ps(q2 + d); a20 = _mm256_fmadd_ps(vq, k0, a20); a21 = _mm256_fmadd_ps(vq, k1, a21);
+                    vq = _mm256_load_ps(q3 + d); a30 = _mm256_fmadd_ps(vq, k0, a30); a31 = _mm256_fmadd_ps(vq, k1, a31);
+                }
+
+                // Horizontal reduce 4 accumulators for t+0 and 4 for t+1
+                __m256 s01_0 = _mm256_hadd_ps(a00, a10);
+                __m256 s23_0 = _mm256_hadd_ps(a20, a30);
+                __m256 s_0   = _mm256_hadd_ps(s01_0, s23_0);
+                __m128 r_0   = _mm_add_ps(_mm256_castps256_ps128(s_0), _mm256_extractf128_ps(s_0, 1));
+                _mm_store_ps(scores[t + 0] + h, _mm_add_ps(r_0, _mm_set1_ps(mv0)));
+
+                __m256 s01_1 = _mm256_hadd_ps(a01, a11);
+                __m256 s23_1 = _mm256_hadd_ps(a21, a31);
+                __m256 s_1   = _mm256_hadd_ps(s01_1, s23_1);
+                __m128 r_1   = _mm_add_ps(_mm256_castps256_ps128(s_1), _mm256_extractf128_ps(s_1, 1));
+                _mm_store_ps(scores[t + 1] + h, _mm_add_ps(r_1, _mm_set1_ps(mv1)));
+            }
+        }
+        if (t < cnt) {
+            const ggml_fp16_t * pk0 = (const ggml_fp16_t *) (k_base + valid_ic[t] * nbk1);
+            for (int d = 0; d < 128; d += 8) {
+                _mm256_store_ps(Kbuf[0] + d, _mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) (pk0 + d))));
+            }
+            const float mv0 = valid_mv[t];
+            for (int h = 0; h < 16; h += 4) {
+                __m256 a0 = _mm256_setzero_ps(), a1 = _mm256_setzero_ps();
+                __m256 a2 = _mm256_setzero_ps(), a3 = _mm256_setzero_ps();
+                for (int d = 0; d < 128; d += 8) {
+                    __m256 k0 = _mm256_load_ps(Kbuf[0] + d);
+                    a0 = _mm256_fmadd_ps(_mm256_load_ps(Qs[h + 0] + d), k0, a0);
+                    a1 = _mm256_fmadd_ps(_mm256_load_ps(Qs[h + 1] + d), k0, a1);
+                    a2 = _mm256_fmadd_ps(_mm256_load_ps(Qs[h + 2] + d), k0, a2);
+                    a3 = _mm256_fmadd_ps(_mm256_load_ps(Qs[h + 3] + d), k0, a3);
+                }
+                __m256 s01 = _mm256_hadd_ps(a0, a1);
+                __m256 s23 = _mm256_hadd_ps(a2, a3);
+                __m256 s_0 = _mm256_hadd_ps(s01, s23);
+                __m128 r_0 = _mm_add_ps(_mm256_castps256_ps128(s_0), _mm256_extractf128_ps(s_0, 1));
+                _mm_store_ps(scores[t] + h, _mm_add_ps(r_0, _mm_set1_ps(mv0)));
+            }
+        }
+
+        // 2. Vectorized block online softmax across all 16 heads (2 x __m256)
+        __m256 m_old0 = _mm256_load_ps(M + 0);
+        __m256 m_old1 = _mm256_load_ps(M + 8);
+        __m256 m_new0 = m_old0;
+        __m256 m_new1 = m_old1;
+
+        for (int i = 0; i < cnt; ++i) {
+            m_new0 = _mm256_max_ps(m_new0, _mm256_load_ps(scores[i] + 0));
+            m_new1 = _mm256_max_ps(m_new1, _mm256_load_ps(scores[i] + 8));
+        }
+
+        alignas(32) float ms[16];
+        __m256 ms0 = ggml_fast_exp_avx2(_mm256_sub_ps(m_old0, m_new0));
+        __m256 ms1 = ggml_fast_exp_avx2(_mm256_sub_ps(m_old1, m_new1));
+        // If m_old was -INFINITY, exp(-inf - m_new) == 0, which correctly zeroes S and VKQ
+        _mm256_store_ps(ms + 0, ms0);
+        _mm256_store_ps(ms + 8, ms1);
+        _mm256_store_ps(M + 0, m_new0);
+        _mm256_store_ps(M + 8, m_new1);
+
+        __m256 s_vec0 = _mm256_mul_ps(_mm256_load_ps(S + 0), ms0);
+        __m256 s_vec1 = _mm256_mul_ps(_mm256_load_ps(S + 8), ms1);
+
+        for (int h = 0; h < 16; ++h) {
+            if (ms[h] != 1.0f && S[h] != 0.0f) {
+                const __m256 vms = _mm256_set1_ps(ms[h]);
+                float * dst_v = VKQ[h];
+                for (int d = 0; d < 128; d += 8) {
+                    _mm256_store_ps(dst_v + d, _mm256_mul_ps(_mm256_load_ps(dst_v + d), vms));
+                }
+            }
+        }
+
+        for (int i = 0; i < cnt; ++i) {
+            __m256 p0 = ggml_fast_exp_avx2(_mm256_sub_ps(_mm256_load_ps(scores[i] + 0), m_new0));
+            __m256 p1 = ggml_fast_exp_avx2(_mm256_sub_ps(_mm256_load_ps(scores[i] + 8), m_new1));
+            _mm256_store_ps(scores[i] + 0, p0);
+            _mm256_store_ps(scores[i] + 8, p1);
+            s_vec0 = _mm256_add_ps(s_vec0, p0);
+            s_vec1 = _mm256_add_ps(s_vec1, p1);
+        }
+
+        _mm256_store_ps(S + 0, s_vec0);
+        _mm256_store_ps(S + 8, s_vec1);
+
+        // 3. Accumulate VKQ[16][128] += P[cnt][16]^T @ V[cnt][128] (loading & converting V once!)
+        int iv = 0;
+        for (; iv + 7 < cnt; iv += 8) {
+            for (int k8 = 0; k8 < 8; ++k8) {
+                const ggml_fp16_t * pv = (const ggml_fp16_t *) (v_base + valid_ic[iv + k8] * nbv1);
+                for (int d = 0; d < 128; d += 8) {
+                    _mm256_store_ps(Vbuf[k8] + d, _mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) (pv + d))));
+                }
+            }
+            for (int h = 0; h < 16; ++h) {
+                __m256 p0 = _mm256_set1_ps(scores[iv + 0][h]);
+                __m256 p1 = _mm256_set1_ps(scores[iv + 1][h]);
+                __m256 p2 = _mm256_set1_ps(scores[iv + 2][h]);
+                __m256 p3 = _mm256_set1_ps(scores[iv + 3][h]);
+                __m256 p4 = _mm256_set1_ps(scores[iv + 4][h]);
+                __m256 p5 = _mm256_set1_ps(scores[iv + 5][h]);
+                __m256 p6 = _mm256_set1_ps(scores[iv + 6][h]);
+                __m256 p7 = _mm256_set1_ps(scores[iv + 7][h]);
+                float * acc = VKQ[h];
+                for (int d = 0; d < 128; d += 8) {
+                    __m256 v_acc = _mm256_load_ps(acc + d);
+                    v_acc = _mm256_fmadd_ps(p0, _mm256_load_ps(Vbuf[0] + d), v_acc);
+                    v_acc = _mm256_fmadd_ps(p1, _mm256_load_ps(Vbuf[1] + d), v_acc);
+                    v_acc = _mm256_fmadd_ps(p2, _mm256_load_ps(Vbuf[2] + d), v_acc);
+                    v_acc = _mm256_fmadd_ps(p3, _mm256_load_ps(Vbuf[3] + d), v_acc);
+                    v_acc = _mm256_fmadd_ps(p4, _mm256_load_ps(Vbuf[4] + d), v_acc);
+                    v_acc = _mm256_fmadd_ps(p5, _mm256_load_ps(Vbuf[5] + d), v_acc);
+                    v_acc = _mm256_fmadd_ps(p6, _mm256_load_ps(Vbuf[6] + d), v_acc);
+                    v_acc = _mm256_fmadd_ps(p7, _mm256_load_ps(Vbuf[7] + d), v_acc);
+                    _mm256_store_ps(acc + d, v_acc);
+                }
+            }
+        }
+        const int rem = cnt - iv;
+        if (rem > 0) {
+            for (int k8 = 0; k8 < rem; ++k8) {
+                const ggml_fp16_t * pv = (const ggml_fp16_t *) (v_base + valid_ic[iv + k8] * nbv1);
+                for (int d = 0; d < 128; d += 8) {
+                    _mm256_store_ps(Vbuf[k8] + d, _mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) (pv + d))));
+                }
+            }
+            for (int h = 0; h < 16; ++h) {
+                float * acc = VKQ[h];
+                for (int k8 = 0; k8 < rem; ++k8) {
+                    __m256 pk = _mm256_set1_ps(scores[iv + k8][h]);
+                    for (int d = 0; d < 128; d += 8) {
+                        _mm256_store_ps(acc + d, _mm256_fmadd_ps(pk, _mm256_load_ps(Vbuf[k8] + d), _mm256_load_ps(acc + d)));
+                    }
+                }
+            }
+        }
+    }
+
+    if (write_partials) {
+        for (int h = 0; h < 16; ++h) {
+            float * partial = chunk_partials + h * partial_stride;
+            partial[0] = M[h];
+            partial[1] = S[h];
+            memcpy(partial + 2, VKQ[h], 128 * sizeof(float));
+        }
+    } else {
+        const size_t nb1 = dst->nb[1];
+        for (int h = 0; h < 16; ++h) {
+            const float S_inv = S[h] == 0.0f ? 0.0f : 1.0f / S[h];
+            const __m256 vinv = _mm256_set1_ps(S_inv);
+            float * out = (float *) ((char *) dst->data + h * nb1);
+            for (int d = 0; d < 128; d += 8) {
+                _mm256_storeu_ps(out + d, _mm256_mul_ps(_mm256_load_ps(VKQ[h] + d), vinv));
+            }
+        }
+    }
+    GGML_UNUSED(params);
+}
+
+// AVX2 8x8 float transpose helper for K tile packing
+static inline void ggml_transpose_8x8_ps(
+        __m256 & r0, __m256 & r1, __m256 & r2, __m256 & r3,
+        __m256 & r4, __m256 & r5, __m256 & r6, __m256 & r7) {
+    __m256 t0 = _mm256_unpacklo_ps(r0, r1);
+    __m256 t1 = _mm256_unpackhi_ps(r0, r1);
+    __m256 t2 = _mm256_unpacklo_ps(r2, r3);
+    __m256 t3 = _mm256_unpackhi_ps(r2, r3);
+    __m256 t4 = _mm256_unpacklo_ps(r4, r5);
+    __m256 t5 = _mm256_unpackhi_ps(r4, r5);
+    __m256 t6 = _mm256_unpacklo_ps(r6, r7);
+    __m256 t7 = _mm256_unpackhi_ps(r6, r7);
+
+    __m256 s0 = _mm256_shuffle_ps(t0, t2, _MM_SHUFFLE(1, 0, 1, 0));
+    __m256 s1 = _mm256_shuffle_ps(t0, t2, _MM_SHUFFLE(3, 2, 3, 2));
+    __m256 s2 = _mm256_shuffle_ps(t1, t3, _MM_SHUFFLE(1, 0, 1, 0));
+    __m256 s3 = _mm256_shuffle_ps(t1, t3, _MM_SHUFFLE(3, 2, 3, 2));
+    __m256 s4 = _mm256_shuffle_ps(t4, t6, _MM_SHUFFLE(1, 0, 1, 0));
+    __m256 s5 = _mm256_shuffle_ps(t4, t6, _MM_SHUFFLE(3, 2, 3, 2));
+    __m256 s6 = _mm256_shuffle_ps(t5, t7, _MM_SHUFFLE(1, 0, 1, 0));
+    __m256 s7 = _mm256_shuffle_ps(t5, t7, _MM_SHUFFLE(3, 2, 3, 2));
+
+    r0 = _mm256_permute2f128_ps(s0, s4, 0x20);
+    r1 = _mm256_permute2f128_ps(s1, s5, 0x20);
+    r2 = _mm256_permute2f128_ps(s2, s6, 0x20);
+    r3 = _mm256_permute2f128_ps(s3, s7, 0x20);
+    r4 = _mm256_permute2f128_ps(s0, s4, 0x31);
+    r5 = _mm256_permute2f128_ps(s1, s5, 0x31);
+    r6 = _mm256_permute2f128_ps(s2, s6, 0x31);
+    r7 = _mm256_permute2f128_ps(s3, s7, 0x31);
+}
+
+// Specialized MQA-16, DK=DV=128, F16 KV fused tiled prefill flash-attention kernel
+// Shares K/V FP16->FP32 conversion & mask checking across all 16 query heads!
+static void ggml_compute_forward_flash_attn_ext_mqa16_d128_prefill_f16(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * q    = dst->src[0];
+    const ggml_tensor * k    = dst->src[1];
+    const ggml_tensor * v    = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+
+    const int64_t N    = q->ne[1];
+    const int64_t nek1 = k->ne[1];
+    const size_t  nbq1 = q->nb[1];
+    const size_t  nbq2 = q->nb[2];
+    const size_t  nbk1 = k->nb[1];
+    const size_t  nbv1 = v->nb[1];
+    const size_t  nb1  = dst->nb[1];
+    const int64_t ne1  = dst->ne[1];
+
+    float scale = 1.0f;
+    memcpy(&scale, (float *) dst->op_params + 0, sizeof(float));
+
+    constexpr int Q_TILE  = 4;  // Matches ggml_fa_tile_config::Q (or multiple of 4)
+    constexpr int KV_TILE = 32; // 128*32*4 = 16 KB K_f32 + 16 KB V_f32 -> L1-resident!
+
+    const int64_t n_qtiles = (N + Q_TILE - 1) / Q_TILE;
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    if (ith == 0) {
+        ggml_threadpool_chunk_set(params->threadpool, nth);
+    }
+    ggml_barrier(params->threadpool);
+
+    alignas(32) float Q_all[16][Q_TILE * 128];   // 32 KB
+    alignas(32) float VKQ_all[16][Q_TILE * 128]; // 32 KB
+    alignas(32) float M_all[16][Q_TILE];
+    alignas(32) float S_all[16][Q_TILE];
+    alignas(32) float K_f32[128 * KV_TILE];      // 16 KB: K_f32[dk * KV_TILE + tk]
+    alignas(32) float V_f32[KV_TILE * 128];      // 16 KB: V_f32[tk * 128 + dv]
+    alignas(32) float mask32[Q_TILE * KV_TILE];
+    alignas(32) float KQ[Q_TILE * KV_TILE];
+
+    const __m256 vscale = _mm256_set1_ps(scale);
+    const char * q_base = (const char *) q->data;
+    const char * k_base = (const char *) k->data;
+    const char * v_base = (const char *) v->data;
+
+    int64_t tile_idx = ith;
+    while (tile_idx < n_qtiles) {
+        const int64_t iq1 = tile_idx * Q_TILE;
+        const int tile_rows = (int) std::min<int64_t>(Q_TILE, N - iq1);
+
+        // Pre-load and pre-scale Q for all 16 heads
+        for (int h = 0; h < 16; ++h) {
+            for (int tq = 0; tq < tile_rows; ++tq) {
+                const float * pq = (const float *) (q_base + (iq1 + tq) * nbq1 + h * nbq2);
+                float * dst_q = Q_all[h] + tq * 128;
+                for (int d = 0; d < 128; d += 8) {
+                    _mm256_store_ps(dst_q + d, _mm256_mul_ps(_mm256_loadu_ps(pq + d), vscale));
+                }
+            }
+            for (int tq = tile_rows; tq < Q_TILE; ++tq) {
+                memset(Q_all[h] + tq * 128, 0, 128 * sizeof(float));
+            }
+            memset(VKQ_all[h], 0, sizeof(VKQ_all[h]));
+            for (int tq = 0; tq < Q_TILE; ++tq) {
+                M_all[h][tq] = -INFINITY;
+                S_all[h][tq] = 0.0f;
+            }
+        }
+
+        for (int64_t ic = 0; ic < nek1; ic += KV_TILE) {
+            const int kv_tile = (int) std::min<int64_t>(KV_TILE, nek1 - ic);
+
+            // Check mask ONCE for all 16 heads!
+            if (mask) {
+                bool can_skip = true;
+                for (int tq = 0; tq < tile_rows; ++tq) {
+                    const ggml_fp16_t * mp_row = (const ggml_fp16_t *) ((const char *) mask->data + (iq1 + tq) * mask->nb[1]) + ic;
+                    float * m_dst = mask32 + tq * KV_TILE;
+                    int tk = 0;
+                    for (; tk + 7 < kv_tile; tk += 8) {
+                        __m256 mv = _mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) (mp_row + tk)));
+                        _mm256_store_ps(m_dst + tk, mv);
+                        if (_mm256_movemask_ps(_mm256_cmp_ps(mv, _mm256_set1_ps(-INFINITY), _CMP_NEQ_OQ))) {
+                            can_skip = false;
+                        }
+                    }
+                    for (; tk < kv_tile; ++tk) {
+                        const float mv = GGML_CPU_FP16_TO_FP32(mp_row[tk]);
+                        m_dst[tk] = mv;
+                        if (mv != -INFINITY) can_skip = false;
+                    }
+                    for (; tk < KV_TILE; ++tk) {
+                        m_dst[tk] = -INFINITY;
+                    }
+                }
+                for (int tq = tile_rows; tq < Q_TILE; ++tq) {
+                    for (int tk = 0; tk < KV_TILE; ++tk) {
+                        mask32[tq * KV_TILE + tk] = -INFINITY;
+                    }
+                }
+                if (can_skip) {
+                    continue;
+                }
+            }
+
+            // Convert & transpose K tile ONCE using AVX2 F16C + 8x8 transpose!
+            if (kv_tile < KV_TILE) {
+                memset(K_f32, 0, sizeof(K_f32));
+                memset(V_f32, 0, sizeof(V_f32));
+            }
+            for (int tk0 = 0; tk0 < kv_tile; tk0 += 8) {
+                const int ntk = std::min(8, kv_tile - tk0);
+                const ggml_fp16_t * pk[8];
+                for (int i = 0; i < ntk; ++i) pk[i] = (const ggml_fp16_t *) (k_base + (ic + tk0 + i) * nbk1);
+                if (ntk == 8) {
+                    for (int d = 0; d < 128; d += 8) {
+                        __m256 r0 = _mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) (pk[0] + d)));
+                        __m256 r1 = _mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) (pk[1] + d)));
+                        __m256 r2 = _mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) (pk[2] + d)));
+                        __m256 r3 = _mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) (pk[3] + d)));
+                        __m256 r4 = _mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) (pk[4] + d)));
+                        __m256 r5 = _mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) (pk[5] + d)));
+                        __m256 r6 = _mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) (pk[6] + d)));
+                        __m256 r7 = _mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) (pk[7] + d)));
+                        ggml_transpose_8x8_ps(r0, r1, r2, r3, r4, r5, r6, r7);
+                        _mm256_store_ps(K_f32 + (d + 0) * KV_TILE + tk0, r0);
+                        _mm256_store_ps(K_f32 + (d + 1) * KV_TILE + tk0, r1);
+                        _mm256_store_ps(K_f32 + (d + 2) * KV_TILE + tk0, r2);
+                        _mm256_store_ps(K_f32 + (d + 3) * KV_TILE + tk0, r3);
+                        _mm256_store_ps(K_f32 + (d + 4) * KV_TILE + tk0, r4);
+                        _mm256_store_ps(K_f32 + (d + 5) * KV_TILE + tk0, r5);
+                        _mm256_store_ps(K_f32 + (d + 6) * KV_TILE + tk0, r6);
+                        _mm256_store_ps(K_f32 + (d + 7) * KV_TILE + tk0, r7);
+                    }
+                } else {
+                    for (int i = 0; i < ntk; ++i) {
+                        for (int d = 0; d < 128; ++d) {
+                            K_f32[d * KV_TILE + tk0 + i] = GGML_CPU_FP16_TO_FP32(pk[i][d]);
+                        }
+                    }
+                }
+            }
+
+            // Convert V tile ONCE using AVX2 F16C!
+            for (int tk = 0; tk < kv_tile; ++tk) {
+                const ggml_fp16_t * pv = (const ggml_fp16_t *) (v_base + (ic + tk) * nbv1);
+                float * dst_v = V_f32 + tk * 128;
+                for (int d = 0; d < 128; d += 8) {
+                    _mm256_store_ps(dst_v + d, _mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) (pv + d))));
+                }
+            }
+
+            // Now compute QK^T -> softmax -> PV across ALL 16 heads while K_f32 & V_f32 sit hot in L1!
+            for (int h = 0; h < 16; ++h) {
+                memset(KQ, 0, sizeof(KQ));
+                simd_gemm(KQ, Q_all[h], K_f32, Q_TILE, 128, KV_TILE);
+
+                if (mask) {
+                    for (int i = 0; i < Q_TILE * KV_TILE; i += 8) {
+                        _mm256_store_ps(KQ + i, _mm256_add_ps(_mm256_load_ps(KQ + i), _mm256_load_ps(mask32 + i)));
+                    }
+                } else if (kv_tile < KV_TILE) {
+                    for (int tq = 0; tq < Q_TILE; ++tq) {
+                        for (int tk = kv_tile; tk < KV_TILE; ++tk) {
+                            KQ[tq * KV_TILE + tk] = -INFINITY;
+                        }
+                    }
+                }
+
+                for (int tq = 0; tq < tile_rows; ++tq) {
+                    float * kq_row = KQ + tq * KV_TILE;
+                    __m256 vm0 = _mm256_max_ps(_mm256_load_ps(kq_row +  0), _mm256_load_ps(kq_row +  8));
+                    __m256 vm1 = _mm256_max_ps(_mm256_load_ps(kq_row + 16), _mm256_load_ps(kq_row + 24));
+                    __m256 vm  = _mm256_max_ps(vm0, vm1);
+                    __m128 m128 = _mm_max_ps(_mm256_castps256_ps128(vm), _mm256_extractf128_ps(vm, 1));
+                    m128 = _mm_max_ps(m128, _mm_movehl_ps(m128, m128));
+                    m128 = _mm_max_ss(m128, _mm_shuffle_ps(m128, m128, 1));
+                    const float tile_max = _mm_cvtss_f32(m128);
+
+                    if (tile_max == -INFINITY) {
+                        memset(kq_row, 0, KV_TILE * sizeof(float));
+                        continue;
+                    }
+
+                    const float Mold = M_all[h][tq];
+                    const float Mnew = fmaxf(Mold, tile_max);
+                    if (Mnew > Mold && S_all[h][tq] != 0.0f) {
+                        const float ms = expf(Mold - Mnew);
+                        const __m256 vms = _mm256_set1_ps(ms);
+                        float * dst_vkq = VKQ_all[h] + tq * 128;
+                        for (int d = 0; d < 128; d += 8) {
+                            _mm256_store_ps(dst_vkq + d, _mm256_mul_ps(_mm256_load_ps(dst_vkq + d), vms));
+                        }
+                        S_all[h][tq] *= ms;
+                    }
+                    M_all[h][tq] = Mnew;
+
+                    const __m256 vmn = _mm256_set1_ps(Mnew);
+                    __m256 p0 = ggml_fast_exp_avx2(_mm256_sub_ps(_mm256_load_ps(kq_row +  0), vmn));
+                    __m256 p1 = ggml_fast_exp_avx2(_mm256_sub_ps(_mm256_load_ps(kq_row +  8), vmn));
+                    __m256 p2 = ggml_fast_exp_avx2(_mm256_sub_ps(_mm256_load_ps(kq_row + 16), vmn));
+                    __m256 p3 = ggml_fast_exp_avx2(_mm256_sub_ps(_mm256_load_ps(kq_row + 24), vmn));
+                    _mm256_store_ps(kq_row +  0, p0);
+                    _mm256_store_ps(kq_row +  8, p1);
+                    _mm256_store_ps(kq_row + 16, p2);
+                    _mm256_store_ps(kq_row + 24, p3);
+                    S_all[h][tq] += ggml_hsum256_ps_fa(_mm256_add_ps(_mm256_add_ps(p0, p1), _mm256_add_ps(p2, p3)));
+                }
+                for (int tq = tile_rows; tq < Q_TILE; ++tq) {
+                    memset(KQ + tq * KV_TILE, 0, KV_TILE * sizeof(float));
+                }
+
+                simd_gemm(VKQ_all[h], KQ, V_f32, Q_TILE, KV_TILE, 128);
+            }
+        }
+
+        // Normalize and write all 16 heads x tile_rows to dst
+        for (int h = 0; h < 16; ++h) {
+            for (int tq = 0; tq < tile_rows; ++tq) {
+                const float S_inv = S_all[h][tq] == 0.0f ? 0.0f : 1.0f / S_all[h][tq];
+                const __m256 vinv = _mm256_set1_ps(S_inv);
+                float * src_v = VKQ_all[h] + tq * 128;
+                float * out_v = (float *) ((char *) dst->data + (h + (iq1 + tq) * ne1) * nb1);
+                for (int d = 0; d < 128; d += 8) {
+                    _mm256_storeu_ps(out_v + d, _mm256_mul_ps(_mm256_load_ps(src_v + d), vinv));
+                }
+            }
+        }
+
+        tile_idx = ggml_threadpool_chunk_add(params->threadpool, 1);
+    }
+}
+#endif
