+extern "C" void ggml_plamo3_lmhead_eval_chunk(
+        const plamo3_lmhead_index * index, const plamo3_lmhead_lut * lut,
+        float * GGML_RESTRICT dst,
+        const void * GGML_RESTRICT src0_q6x8,
+        const void * GGML_RESTRICT src1_q8k,
+        int ith, int nth) {
+    constexpr int N_GROUPS = 3360;
+    constexpr int N_SB     = 6;
+
+    const int g_start = (ith * N_GROUPS) / nth;
+    const int g_end   = ((ith + 1) * N_GROUPS) / nth;
+    if (g_start >= g_end) return;
+
+    int k_panels = (384 + nth - 1) / nth;
+    if (k_panels < 20)  k_panels = 20;
+    if (k_panels > 128) k_panels = 128;
+
+    float top_score[128];
+    int   top_panel[128];
+    for (int i = 0; i < k_panels; ++i) {
+        top_score[i] = -1e30f;
+        top_panel[i] = -1;
+    }
+    float thresh = -1e30f;
+    int   min_idx = 0;
+
+    const __m256i m0f      = _mm256_set1_epi8(0x0F);
+    const __m256  v_shift  = _mm256_set1_ps(-1000.0f);
+    __m256        v_thresh = _mm256_set1_ps(thresh);
+
+    auto hmax8 = [](__m256 v) -> float {
+        __m128 lo = _mm256_castps256_ps128(v);
+        __m128 hi = _mm256_extractf128_ps(v, 1);
+        lo = _mm_max_ps(lo, hi);
+        lo = _mm_max_ps(lo, _mm_movehl_ps(lo, lo));
+        lo = _mm_max_ss(lo, _mm_shuffle_ps(lo, lo, 1));
+        return _mm_cvtss_f32(lo);
+    };
+
+    auto consider_panel = [&](__m256 acc, int panel_id) {
+        if (_mm256_movemask_ps(_mm256_cmp_ps(acc, v_thresh, _CMP_GT_OQ))) {
+            const float pm = hmax8(acc);
+            if (pm > thresh) {
+                top_score[min_idx] = pm;
+                top_panel[min_idx] = panel_id;
+                float new_min = top_score[0];
+                int   new_idx = 0;
+                for (int i = 1; i < k_panels; ++i) {
+                    if (top_score[i] < new_min) {
+                        new_min = top_score[i];
+                        new_idx = i;
+                    }
+                }
+                thresh   = new_min;
+                min_idx  = new_idx;
+                v_thresh = _mm256_set1_ps(thresh);
+            }
+        }
+    };
+
+    // Stage 1: L3-resident 1-bit sign vpshufb LUT scan over 32-row groups
+    for (int g = g_start; g < g_end; ++g) {
+        const uint8_t     * g_bits   = index->bits      + (size_t) g * N_SB * 1024;
+        const ggml_fp16_t * g_scales = index->sb_scales + (size_t) g * N_SB * 32;
+
+        if (g + 2 < g_end) {
+            _mm_prefetch((const char *) (g_bits + 2 * N_SB * 1024), _MM_HINT_T0);
+        }
+
+        __m256 acc0 = _mm256_setzero_ps();
+        __m256 acc1 = _mm256_setzero_ps();
+        __m256 acc2 = _mm256_setzero_ps();
+        __m256 acc3 = _mm256_setzero_ps();
+
+        for (int b = 0; b < N_SB; ++b) {
+            const uint8_t * b_bits = g_bits + b * 1024;
+            const int8_t (* b_lut)[16] = lut->values[b];
+
+            __m256i s_even = _mm256_setzero_si256();
+            __m256i s_odd  = _mm256_setzero_si256();
+
+            for (int k = 0; k < 32; k += 2) {
+                const __m256i b0 = _mm256_load_si256((const __m256i *) (b_bits + (k + 0) * 32));
+                const __m256i b1 = _mm256_load_si256((const __m256i *) (b_bits + (k + 1) * 32));
+
+                const __m256i l0 = _mm256_broadcastsi128_si256(_mm_load_si128((const __m128i *) b_lut[k * 2 + 0]));
+                const __m256i l1 = _mm256_broadcastsi128_si256(_mm_load_si128((const __m128i *) b_lut[k * 2 + 1]));
+                const __m256i l2 = _mm256_broadcastsi128_si256(_mm_load_si128((const __m128i *) b_lut[k * 2 + 2]));
+                const __m256i l3 = _mm256_broadcastsi128_si256(_mm_load_si128((const __m128i *) b_lut[k * 2 + 3]));
+
+                const __m256i v0 = _mm256_shuffle_epi8(l0, _mm256_and_si256(b0, m0f));
+                const __m256i v1 = _mm256_shuffle_epi8(l1, _mm256_and_si256(_mm256_srli_epi16(b0, 4), m0f));
+                const __m256i v2 = _mm256_shuffle_epi8(l2, _mm256_and_si256(b1, m0f));
+                const __m256i v3 = _mm256_shuffle_epi8(l3, _mm256_and_si256(_mm256_srli_epi16(b1, 4), m0f));
+
+                const __m256i s8 = _mm256_add_epi8(_mm256_add_epi8(v0, v1), _mm256_add_epi8(v2, v3));
+                s_even = _mm256_add_epi16(s_even, _mm256_srai_epi16(_mm256_slli_epi16(s8, 8), 8));
+                s_odd  = _mm256_add_epi16(s_odd,  _mm256_srai_epi16(s8, 8));
+            }
+
+            const __m256 xs = _mm256_set1_ps(lut->x_scale[b]);
+            const ggml_fp16_t * sc_b = g_scales + b * 32;
+
+            const __m256 sc0 = _mm256_mul_ps(_mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) (sc_b +  0))), xs);
+            const __m256 sc1 = _mm256_mul_ps(_mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) (sc_b +  8))), xs);
+            const __m256 sc2 = _mm256_mul_ps(_mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) (sc_b + 16))), xs);
+            const __m256 sc3 = _mm256_mul_ps(_mm256_cvtph_ps(_mm_loadu_si128((const __m128i *) (sc_b + 24))), xs);
+
+            acc0 = _mm256_fmadd_ps(_mm256_cvtepi32_ps(_mm256_cvtepi16_epi32(_mm256_castsi256_si128(s_even))),   sc0, acc0);
+            acc1 = _mm256_fmadd_ps(_mm256_cvtepi32_ps(_mm256_cvtepi16_epi32(_mm256_castsi256_si128(s_odd))),    sc1, acc1);
+            acc2 = _mm256_fmadd_ps(_mm256_cvtepi32_ps(_mm256_cvtepi16_epi32(_mm256_extracti128_si256(s_even, 1))), sc2, acc2);
+            acc3 = _mm256_fmadd_ps(_mm256_cvtepi32_ps(_mm256_cvtepi16_epi32(_mm256_extracti128_si256(s_odd, 1))),  sc3, acc3);
+        }
+
+        float * out = dst + g * 32;
+        _mm256_storeu_ps(out +  0, _mm256_add_ps(acc0, v_shift));
+        _mm256_storeu_ps(out +  8, _mm256_add_ps(acc1, v_shift));
+        _mm256_storeu_ps(out + 16, _mm256_add_ps(acc2, v_shift));
+        _mm256_storeu_ps(out + 24, _mm256_add_ps(acc3, v_shift));
+
+        consider_panel(acc0, g * 4 + 0);
+        consider_panel(acc1, g * 4 + 1);
+        consider_panel(acc2, g * 4 + 2);
+        consider_panel(acc3, g * 4 + 3);
+    }
+
+    // Stage 2: Exact Q6_K rescoring of top candidate 8-row panels (zero extra barriers)
+    const block_q6_Kx8 * q6_base = (const block_q6_Kx8 *) src0_q6x8;
+    for (int i = 0; i < k_panels; ++i) {
+        const int panel = top_panel[i];
+        if (panel >= 0) {
+            ggml_gemv_q6_K_8x4_q8_K_vnni(1536, dst + panel * 8, 107520, q6_base + (size_t) panel * N_SB, src1_q8k, 1, 8);
+        }
+    }
+}
