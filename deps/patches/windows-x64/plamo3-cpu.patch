+// ============================================================================
+// Specialized 2-Stage 1-bit Sign LUT Screening + Exact Q6_K Rescoring for
+// PLaMo-3 0.8B output.weight (1536 x 107520, Q6_K)
+// ============================================================================
+#if defined(__AVX2__) && defined(__FMA__) && defined(__F16C__)
+#include "../../plamo3-lmhead.h"
+
+extern "C" void ggml_plamo3_lmhead_build_1bit(plamo3_lmhead_index * index, const void * raw_q6k_data) {
+    ::new (index) plamo3_lmhead_index;
+    constexpr int N_ROWS   = 107520;
+    constexpr int N_GROUPS = N_ROWS / 32; // 3360
+    constexpr int N_SB     = 6;           // 1536 / 256
+
+    static const int row_to_slot[32] = {
+         0,  2,  4,  6,  8, 10, 12, 14,
+         1,  3,  5,  7,  9, 11, 13, 15,
+        16, 18, 20, 22, 24, 26, 28, 30,
+        17, 19, 21, 23, 25, 27, 29, 31
+    };
+
+    const block_q6_K * src = (const block_q6_K *) raw_q6k_data;
+
+    auto worker = [&](int g_begin, int g_end) {
+        for (int g = g_begin; g < g_end; ++g) {
+            uint8_t     * g_bits   = index->bits      + (size_t) g * N_SB * 1024;
+            ggml_fp16_t * g_scales = index->sb_scales + (size_t) g * N_SB * 32;
+
+            for (int r = 0; r < 32; ++r) {
+                const int row  = g * 32 + r;
+                const int slot = row_to_slot[r];
+                const block_q6_K * row_blks = src + (size_t) row * N_SB;
+
+                for (int b = 0; b < N_SB; ++b) {
+                    const block_q6_K & blk = row_blks[b];
+                    const float d = GGML_CPU_FP16_TO_FP32(blk.d);
+                    float w[256];
+                    float abs_sum = 0.0f;
+
+                    for (int half = 0; half < 2; ++half) {
+                        const uint8_t * ql = blk.ql + half * 64;
+                        const uint8_t * qh = blk.qh + half * 32;
+                        const int8_t  * sc = blk.scales + half * 8;
+                        for (int l = 0; l < 32; ++l) {
+                            const int is = l >> 4;
+                            const int8_t q1 = (int8_t)((ql[l]      & 0xF) | (((qh[l] >> 0) & 3) << 4)) - 32;
+                            const int8_t q2 = (int8_t)((ql[l + 32] & 0xF) | (((qh[l] >> 2) & 3) << 4)) - 32;
+                            const int8_t q3 = (int8_t)((ql[l]      >> 4)  | (((qh[l] >> 4) & 3) << 4)) - 32;
+                            const int8_t q4 = (int8_t)((ql[l + 32] >> 4)  | (((qh[l] >> 6) & 3) << 4)) - 32;
+                            const float v1 = d * sc[is + 0] * q1;
+                            const float v2 = d * sc[is + 2] * q2;
+                            const float v3 = d * sc[is + 4] * q3;
+                            const float v4 = d * sc[is + 6] * q4;
+                            w[half * 128 + l +  0] = v1;
+                            w[half * 128 + l + 32] = v2;
+                            w[half * 128 + l + 64] = v3;
+                            w[half * 128 + l + 96] = v4;
+                            abs_sum += fabsf(v1) + fabsf(v2) + fabsf(v3) + fabsf(v4);
+                        }
+                    }
+
+                    g_scales[b * 32 + r] = GGML_CPU_FP32_TO_FP16(abs_sum * (1.0f / 256.0f));
+                    uint8_t * b_bits = g_bits + b * 1024;
+                    for (int k = 0; k < 32; ++k) {
+                        const float * wk = w + k * 8;
+                        uint8_t mask = 0;
+                        if (wk[0] >= 0.0f) mask |= 0x01;
+                        if (wk[1] >= 0.0f) mask |= 0x02;
+                        if (wk[2] >= 0.0f) mask |= 0x04;
+                        if (wk[3] >= 0.0f) mask |= 0x08;
+                        if (wk[4] >= 0.0f) mask |= 0x10;
+                        if (wk[5] >= 0.0f) mask |= 0x20;
+                        if (wk[6] >= 0.0f) mask |= 0x40;
+                        if (wk[7] >= 0.0f) mask |= 0x80;
+                        b_bits[k * 32 + slot] = mask;
+                    }
+                }
+            }
+        }
+    };
+
+    constexpr int N_BUILD_TH = 8;
+    std::thread ths[N_BUILD_TH - 1];
+    int started = 0;
+    try {
+        for (; started < N_BUILD_TH - 1; ++started) {
+            ths[started] = std::thread(worker, started * N_GROUPS / N_BUILD_TH, (started + 1) * N_GROUPS / N_BUILD_TH);
+        }
+    } catch (const std::system_error &) {
+        // Finish any unassigned rows on the loading thread.
+    }
+    worker(started * N_GROUPS / N_BUILD_TH, N_GROUPS);
+    for (int t = 0; t < started; ++t) ths[t].join();
+}
+
+extern "C" void ggml_plamo3_lmhead_prepare_lut(plamo3_lmhead_lut * lut, const float * x) {
+    ::new (lut) plamo3_lmhead_lut;
+    constexpr int N_SB = 6;
+    for (int b = 0; b < N_SB; ++b) {
+        const float * xb = x + b * 256;
+        float max_g4 = 0.0f;
+        for (int j = 0; j < 64; ++j) {
+            const float s = fabsf(xb[j * 4 + 0]) + fabsf(xb[j * 4 + 1]) + fabsf(xb[j * 4 + 2]) + fabsf(xb[j * 4 + 3]);
+            if (s > max_g4) max_g4 = s;
+        }
+        lut->x_scale[b] = max_g4 * (1.0f / 31.0f);
+        const float inv = (max_g4 > 0.0f) ? (31.0f / max_g4) : 0.0f;
+        for (int j = 0; j < 64; ++j) {
+            const float v0 = xb[j * 4 + 0] * inv;
+            const float v1 = xb[j * 4 + 1] * inv;
+            const float v2 = xb[j * 4 + 2] * inv;
+            const float v3 = xb[j * 4 + 3] * inv;
+            int8_t * dst = lut->values[b][j];
+            for (int m = 0; m < 8; ++m) {
+                const float val = ((m & 1) ? v0 : -v0) + ((m & 2) ? v1 : -v1) + ((m & 4) ? v2 : -v2) - v3;
+                const int8_t q = (int8_t) lrintf(val);
+                dst[m]      = q;
+                dst[m ^ 15] = (int8_t) (-q);
+            }
+        }
+    }
+}
