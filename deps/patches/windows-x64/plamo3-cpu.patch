+static inline bool ggml_plamo3_try_flash_attn_ext_f16(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * q       = dst->src[0];
+    const ggml_tensor * k       = dst->src[1];
+    const ggml_tensor * v       = dst->src[2];
+    const ggml_tensor * kv_rows = dst->src[5];
+
+    const int64_t DK   = k->ne[0];
+    const int64_t DV   = v->ne[0];
+    const int64_t neq1 = q->ne[1];
+    const int64_t neq2 = q->ne[2];
+    const int64_t neq3 = q->ne[3];
+    const int64_t nek1 = k->ne[1];
+    const int64_t nek2 = k->ne[2];
+    const int64_t nev2 = v->ne[2];
+    const size_t  nb1  = dst->nb[1];
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+    const bool use_ref = params->use_ref;
+
+
+#if defined(__AVX2__) && defined(__FMA__) && defined(__F16C__)
+    {
+        const ggml_tensor * mask  = dst->src[3];
+        const ggml_tensor * sinks = dst->src[4];
+        float max_bias_check = 0.0f, logit_softcap_check = 0.0f;
+        memcpy(&max_bias_check,      (float *) dst->op_params + 1, sizeof(float));
+        memcpy(&logit_softcap_check, (float *) dst->op_params + 2, sizeof(float));
+
+        const bool use_mqa16_d128_common = !use_ref && !kv_rows && !sinks &&
+            (neq3 == 1 && neq2 == 16 && nek2 == 1 && nev2 == 1 && DK == 128 && DV == 128) &&
+            (k->type == GGML_TYPE_F16 && v->type == GGML_TYPE_F16 && q->type == GGML_TYPE_F32) &&
+            (max_bias_check == 0.0f && logit_softcap_check == 0.0f) &&
+            dst->nb[1] == DV * sizeof(float) && ggml_is_contiguous(dst) &&
+            k->ne[1] == v->ne[1] &&
+            (!mask || (mask->type == GGML_TYPE_F16 && mask->nb[0] == sizeof(ggml_fp16_t) &&
+                       mask->ne[0] >= nek1 && mask->ne[1] >= neq1 && mask->ne[2] == 1 && mask->ne[3] == 1));
+
+        if (use_mqa16_d128_common && neq1 >= 4) {
+            ggml_compute_forward_flash_attn_ext_mqa16_d128_prefill_f16(params, dst);
+            return true;
+        }
+
+        const bool use_mqa16_d128_fast = use_mqa16_d128_common && (neq1 == 1);
+
+        if (use_mqa16_d128_fast) {
+            // Find active [kv_begin, kv_end) range when mask is present (skips masked SWA prefix/suffix)
+            int64_t kv_begin = 0;
+            int64_t kv_end   = nek1;
+            if (mask) {
+                const ggml_fp16_t * mp = (const ggml_fp16_t *) mask->data;
+                const __m256i v_neginf = _mm256_set1_epi16((short) 0xFC00);
+                while (kv_begin + 16 <= kv_end) {
+                    __m256i m16 = _mm256_loadu_si256((const __m256i *) (mp + kv_begin));
+                    if (_mm256_movemask_epi8(_mm256_cmpeq_epi16(m16, v_neginf)) == (int) 0xFFFFFFFF) {
+                        kv_begin += 16;
+                    } else {
+                        break;
+                    }
+                }
+                while (kv_end - 16 >= kv_begin) {
+                    __m256i m16 = _mm256_loadu_si256((const __m256i *) (mp + kv_end - 16));
+                    if (_mm256_movemask_epi8(_mm256_cmpeq_epi16(m16, v_neginf)) == (int) 0xFFFFFFFF) {
+                        kv_end -= 16;
+                    } else {
+                        break;
+                    }
+                }
+            }
+
+            const int64_t n_active_kv = kv_end - kv_begin;
+            if (n_active_kv <= 128 || nth == 1) {
+                if (ith == 0) {
+                    ggml_compute_forward_flash_attn_ext_mqa16_d128_f16(params, dst, kv_begin, kv_end, nullptr, 0);
+                }
+                return true;
+            }
+
+            // Cap chunks to 8 (one per physical P-core) so the 26 KB stack working set stays 100% in 48 KB L1D!
+            const int64_t max_chunks     = std::min<int64_t>(nth, 8);
+            const int64_t n_chunks       = std::min<int64_t>(max_chunks, (n_active_kv + 63) / 64);
+            const int64_t chunk_size     = (n_active_kv + n_chunks - 1) / n_chunks;
+            const int64_t partial_size   = 2 + DV;
+            const int64_t partial_stride = n_chunks * partial_size;
+            const int64_t offset = nth * (DK + 2*DV + CACHE_LINE_SIZE_F32);
+            if (!params->wdata || params->wsize < sizeof(float) * (offset + 16 * partial_stride)) return false;
+            float * partials_base = (float *) params->wdata + offset;
+
+            if (ith < n_chunks) {
+                const int64_t ic_start = kv_begin + ith * chunk_size;
+                const int64_t ic_end   = std::min(ic_start + chunk_size, kv_end);
+                float * chunk_partials = partials_base + ith * partial_size;
+                if (ic_start < ic_end) {
+                    ggml_compute_forward_flash_attn_ext_mqa16_d128_f16(params, dst, ic_start, ic_end, chunk_partials, partial_stride);
+                } else {
+                    for (int h = 0; h < 16; ++h) {
+                        float * qp = chunk_partials + h * partial_stride;
+                        qp[0] = -INFINITY;
+                        qp[1] = 0.0f;
+                    }
+                }
+            }
+
+            ggml_barrier(params->threadpool);
+
+            // Fast AVX2 reduction across n_chunks for each of the 16 query heads
+            for (int64_t q_head = ith; q_head < 16; q_head += nth) {
+                float M_final = -INFINITY;
+                float S_final = 0.0f;
+                alignas(32) float VKQ_final[128] = {};
+
+                for (int64_t c = 0; c < n_chunks; ++c) {
+                    const float * partial   = partials_base + (q_head * n_chunks + c) * partial_size;
+                    const float   M_chunk   = partial[0];
+                    const float   S_chunk   = partial[1];
+                    const float * VKQ_chunk = partial + 2;
+                    if (S_chunk == 0.0f) continue;
+
+                    if (S_final == 0.0f) {
+                        M_final = M_chunk;
+                        S_final = S_chunk;
+                        memcpy(VKQ_final, VKQ_chunk, 128 * sizeof(float));
+                    } else {
+                        const float M_new     = fmaxf(M_final, M_chunk);
+                        const float scale_old = expf(M_final - M_new);
+                        const float scale_new = expf(M_chunk - M_new);
+                        const __m256 v_so = _mm256_set1_ps(scale_old);
+                        const __m256 v_sn = _mm256_set1_ps(scale_new);
+                        for (int d = 0; d < 128; d += 8) {
+                            __m256 vf = _mm256_mul_ps(_mm256_load_ps(VKQ_final + d), v_so);
+                            vf = _mm256_fmadd_ps(_mm256_loadu_ps(VKQ_chunk + d), v_sn, vf);
+                            _mm256_store_ps(VKQ_final + d, vf);
+                        }
+                        S_final = S_final * scale_old + S_chunk * scale_new;
+                        M_final = M_new;
+                    }
+                }
+
+                const float S_inv = S_final == 0.0f ? 0.0f : 1.0f / S_final;
+                const __m256 vinv = _mm256_set1_ps(S_inv);
+                float * out = (float *) ((char *) dst->data + q_head * nb1);
+                for (int d = 0; d < 128; d += 8) {
+                    _mm256_storeu_ps(out + d, _mm256_mul_ps(_mm256_load_ps(VKQ_final + d), vinv));
+                }
+            }
+            return true;
+        }
+    }
+#endif
+
+
+    GGML_UNUSED(params);
+    GGML_UNUSED(dst);
+    GGML_UNUSED(q);
+    GGML_UNUSED(k);
+    GGML_UNUSED(v);
+    GGML_UNUSED(kv_rows);
+    GGML_UNUSED(DK);
+    GGML_UNUSED(DV);
+    GGML_UNUSED(neq1);
+    GGML_UNUSED(neq2);
+    GGML_UNUSED(neq3);
+    GGML_UNUSED(nek1);
+    GGML_UNUSED(nek2);
+    GGML_UNUSED(nev2);
+    GGML_UNUSED(nb1);
+    GGML_UNUSED(ith);
+    GGML_UNUSED(nth);
+    GGML_UNUSED(use_ref);
+    return false;
+}
diff --git a/ggml/src/ggml-cpu/plamo3-lmhead.h b/ggml/src/ggml-cpu/plamo3-lmhead.h
new file mode 100644
index 0000000000000000000000000000000000000000..4f5a5cdb61670e44e4b943509ad7e80febf724f4
--- /dev/null
+++ b/ggml/src/ggml-cpu/plamo3-lmhead.h
@@ -0,0 +1,23 @@
+#pragma once
+
+// The immutable sign index follows the repacked Q6_K tensor in its ggml
+// buffer. Each graph uses its own activation lookup table in plan workspace.
+struct alignas(64) plamo3_lmhead_index {
+    uint8_t bits[3360 * 6 * 1024];
+    ggml_fp16_t sb_scales[3360 * 6 * 32];
+};
+
+struct alignas(64) plamo3_lmhead_lut {
+    int8_t values[6][64][16];
+    float x_scale[6];
+};
+
+template<typename T> static T * plamo3_tail(void * data, size_t bytes) {
+    uintptr_t addr = reinterpret_cast<uintptr_t>(data) + bytes;
+    return reinterpret_cast<T *>((addr + alignof(T) - 1) & ~(uintptr_t(alignof(T)) - 1));
+}
+
+extern "C" void ggml_plamo3_lmhead_build_1bit(plamo3_lmhead_index * index, const void * raw);
+extern "C" void ggml_plamo3_lmhead_prepare_lut(plamo3_lmhead_lut * lut, const float * x);
+extern "C" void ggml_plamo3_lmhead_eval_chunk(const plamo3_lmhead_index * index, const plamo3_lmhead_lut * lut,
+                                              float * dst, const void * weights, const void * activation, int ith, int nth);
diff --git a/ggml/src/ggml-cpu/plamo3-sched.h b/ggml/src/ggml-cpu/plamo3-sched.h
new file mode 100644
index 0000000000000000000000000000000000000000..6c91470a8ae176bdae8f02514c35a4d18ec570c8
--- /dev/null
+++ b/ggml/src/ggml-cpu/plamo3-sched.h
@@ -0,0 +1,134 @@
+#pragma once
+
+// PLaMo-3 0.8B CPU scheduling optimizations:
+//   1. Core-0 tiny-op chain batching (eliminates intermediate threadpool barriers
+//      and keeps small elementwise/RoPE/KV-write tensors hot in Core-0 L1D).
+//   2. Windows hybrid P+E core topology auto-pinning (P-phys -> P-SMT -> E-cores)
+//      and single-token decode thread clamping to P-cores.
+
+#include "ggml.h"
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#endif
+
+static inline bool ggml_plamo3_is_tiny_single_thread_op(const struct ggml_tensor * node) {
+    if (!node) return false;
+    switch (node->op) {
+        case GGML_OP_RMS_NORM:
+        case GGML_OP_MUL:
+        case GGML_OP_ADD:
+        case GGML_OP_ROPE:
+        case GGML_OP_GLU:
+        case GGML_OP_CPY:
+        case GGML_OP_CONT:
+            if (ggml_nelements(node) > 8192) return false;
+            if (node->src[0] && ggml_nelements(node->src[0]) > 16384) return false;
+            return true;
+        case GGML_OP_GET_ROWS:
+            return ggml_nelements(node) <= 8192;
+        case GGML_OP_SET_ROWS:
+            return node->src[0] && ggml_nelements(node->src[0]) <= 8192;
+        default:
+            return false;
+    }
+}
+
+static inline int ggml_plamo3_find_tiny_op_run_end(const struct ggml_cgraph * cgraph, int node_n) {
+    int run_end = node_n;
+    while (run_end + 1 < cgraph->n_nodes) {
+        struct ggml_tensor * nxt = cgraph->nodes[run_end + 1];
+        if (ggml_op_is_empty(nxt->op) || (nxt->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            run_end++;
+            continue;
+        }
+        if (ggml_plamo3_is_tiny_single_thread_op(nxt)) {
+            run_end++;
+            continue;
+        }
+        break;
+    }
+    return run_end;
+}
+
+
+// ggml's Windows cpumask addresses one processor group. Intersect with the
+// process affinity before choosing one worker per physical performance core.
+struct plamo3_topology {
+    int order[GGML_MAX_N_THREADS];
+    int n_performance;
+    int count;
+};
+
+static struct plamo3_topology plamo3_detect_topology(void) {
+    struct plamo3_topology topo = {0};
+    DWORD_PTR allowed, system_mask;
+    if (GetActiveProcessorGroupCount() != 1 ||
+        !GetProcessAffinityMask(GetCurrentProcess(), &allowed, &system_mask)) return topo;
+    DWORD len = 0;
+    GetLogicalProcessorInformationEx(RelationProcessorCore, NULL, &len);
+    if (!len) return topo;
+    uint8_t * buf = (uint8_t *) malloc(len);
+    if (!buf) return topo;
+    if (GetLogicalProcessorInformationEx(RelationProcessorCore, (PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX) buf, &len)) {
+        unsigned min_class = 255, max_class = 0;
+        for (DWORD off = 0; off < len;) {
+            PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX core = (PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX)(buf + off);
+            if (core->Processor.GroupMask[0].Mask & allowed) {
+                unsigned eff = core->Processor.EfficiencyClass;
+                if (eff > max_class) max_class = eff;
+                if (eff < min_class) min_class = eff;
+            }
+            off += core->Size;
+        }
+        // First logical processor of each P core, its SMT siblings, then E cores.
+        for (int pass = 0; min_class < max_class && pass < 3; ++pass) {
+            for (DWORD off = 0; off < len;) {
+                PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX core = (PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX)(buf + off);
+                bool performance = core->Processor.EfficiencyClass == max_class;
+                DWORD_PTR mask = core->Processor.GroupMask[0].Mask & allowed;
+                bool first = true;
+                for (unsigned bit = 0; mask; ++bit, mask >>= 1) {
+                    if (!(mask & 1)) continue;
+                    if ((performance ? (first ? 0 : 1) : 2) == pass && bit < GGML_MAX_N_THREADS) {
+                        topo.order[topo.count++] = (int) bit;
+                        if (performance) ++topo.n_performance;
+                    }
+                    first = false;
+                }
+                off += core->Size;
+            }
+        }
+    }
+    free(buf);
+    return topo;
+}
+
+static bool plamo3_pin_worker(const struct plamo3_topology * topo, int idx, bool * mask) {
+    if (idx >= topo->count) return false;
+    memset(mask, 0, GGML_MAX_N_THREADS * sizeof(bool));
+    mask[topo->order[idx]] = true;
+    return true;
+}
+
+static int ggml_plamo3_win32_clamp_decode_threads(const struct ggml_cgraph * graph, int threads, int cap) {
+    if (cap > 0 && threads > cap) {
+        for (int i = 0; i < graph->n_nodes; ++i) {
+            const struct ggml_tensor * node = graph->nodes[i];
+            if (node->op == GGML_OP_MUL_MAT && node->src[1]) {
+                if (ggml_nrows(node->src[1]) == 1) return cap;
+                break;
+            }
+        }
+    }
+    return threads;
+}
