+                            iacc2 = _mm256_add_epi32(iacc2, _mm256_add_epi32(_mm256_mullo_epi32(_mm256_sub_epi32(a0_r2, _mm256_set1_epi32((int32_t) bsh[ 8 + sh] << 5)), sc2), _mm256_mullo_epi32(_mm256_sub_epi32(a1_r2, _mm256_set1_epi32((int32_t) bsh[10 + sh] << 5)), sc3)));
