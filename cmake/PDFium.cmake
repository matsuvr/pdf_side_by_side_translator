if(NOT EXISTS "${OPT_PDFIUM_MANIFEST}")
    message(FATAL_ERROR "PDFium manifest missing. Run scripts/bootstrap.py --target ${OPT_TARGET} first.")
endif()
file(READ "${OPT_PDFIUM_MANIFEST}" pdfium_json)
string(JSON pdfium_revision GET "${pdfium_json}" revision)
file(READ "${PROJECT_SOURCE_DIR}/deps/third_party.lock.json" dependency_lock)
string(JSON pdfium_expected GET "${dependency_lock}" dependencies PDFium revision)
if(NOT pdfium_revision STREQUAL pdfium_expected)
    message(FATAL_ERROR "PDFium manifest does not match dependency lock")
endif()
string(JSON manifest_target GET "${pdfium_json}" target)
if(NOT manifest_target STREQUAL OPT_TARGET)
    message(FATAL_ERROR "PDFium manifest target differs from selected preset")
endif()
add_library(PDFium::PDFium INTERFACE IMPORTED)
foreach(field archives public_includes public_definitions system_libraries frameworks)
    string(JSON count LENGTH "${pdfium_json}" ${field})
    set(values)
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(i RANGE ${last})
            string(JSON value GET "${pdfium_json}" ${field} ${i})
            if(field STREQUAL frameworks)
                list(APPEND values "-framework ${value}")
            else()
                list(APPEND values "${value}")
            endif()
        endforeach()
    endif()
    if(field STREQUAL public_includes)
        set_property(TARGET PDFium::PDFium PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${values}")
    elseif(field STREQUAL public_definitions)
        set_property(TARGET PDFium::PDFium PROPERTY INTERFACE_COMPILE_DEFINITIONS "${values}")
    else()
        set_property(TARGET PDFium::PDFium APPEND PROPERTY INTERFACE_LINK_LIBRARIES "${values}")
    endif()
endforeach()
string(JSON link_count LENGTH "${pdfium_json}" consumer_link_options)
if(link_count GREATER 0)
    math(EXPR last "${link_count} - 1")
    foreach(i RANGE ${last})
        string(JSON value GET "${pdfium_json}" consumer_link_options ${i})
        set_property(TARGET PDFium::PDFium APPEND PROPERTY INTERFACE_LINK_OPTIONS "${value}")
    endforeach()
endif()
