# The official checkout is shared with the license audit. Only the Windows
# x64 clang-cl build consumes the separately prepared CPU worktree.
set(opt_llama_source "${OPT_DEPENDENCIES}/llama.cpp")
set(opt_windows_kernels OFF)
if(WIN32 AND MSVC AND CMAKE_C_COMPILER_ID STREQUAL "Clang" AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|amd64|x86_64)$")
    set(opt_llama_source "${OPT_DEPENDENCIES}/windows-x64/llama.cpp")
    set(opt_windows_kernels ON)
endif()

if(NOT EXISTS "${opt_llama_source}/.git")
    message(FATAL_ERROR "Missing prepared llama.cpp at ${opt_llama_source}: run scripts/bootstrap.py --target ${OPT_TARGET}")
endif()
find_package(Git REQUIRED)
set(opt_lock_file "${PROJECT_SOURCE_DIR}/deps/third_party.lock.json")
file(READ "${opt_lock_file}" opt_llama_lock)
string(JSON opt_upstream_revision GET "${opt_llama_lock}" dependencies llama.cpp revision)
function(opt_require_llama_revision ref expected)
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse "${ref}"
        WORKING_DIRECTORY "${opt_llama_source}" RESULT_VARIABLE status
        OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT status EQUAL 0 OR NOT actual STREQUAL expected)
        message(FATAL_ERROR "Unexpected llama.cpp ${ref} in ${opt_llama_source}. Run scripts/bootstrap.py --target ${OPT_TARGET} --skip-pdfium")
    endif()
endfunction()
if(opt_windows_kernels)
    string(JSON opt_windows_tree GET "${opt_llama_lock}" patches 0 tree)
    opt_require_llama_revision("HEAD^" "${opt_upstream_revision}")
    opt_require_llama_revision("HEAD^{tree}" "${opt_windows_tree}")
else()
    opt_require_llama_revision(HEAD "${opt_upstream_revision}")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" diff --quiet HEAD --
    WORKING_DIRECTORY "${opt_llama_source}" RESULT_VARIABLE opt_llama_modified)
if(NOT opt_llama_modified EQUAL 0)
    message(FATAL_ERROR "Tracked llama.cpp sources differ from the locked checkout in ${opt_llama_source}")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --absolute-git-dir
    WORKING_DIRECTORY "${opt_llama_source}" OUTPUT_VARIABLE opt_llama_git_dir OUTPUT_STRIP_TRAILING_WHITESPACE)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${opt_lock_file}" "${opt_llama_git_dir}/HEAD")

set(GGML_BACKEND_DL OFF CACHE BOOL "" FORCE)
set(GGML_NATIVE OFF CACHE BOOL "" FORCE)
set(GGML_OPENMP OFF CACHE BOOL "" FORCE)
set(GGML_CPU ON CACHE BOOL "" FORCE)
set(GGML_CCACHE OFF CACHE BOOL "" FORCE)
set(GGML_BLAS OFF CACHE BOOL "" FORCE)
set(GGML_ACCELERATE ${APPLE} CACHE BOOL "" FORCE)
if(APPLE)
    set(GGML_METAL ON CACHE BOOL "" FORCE)
    set(GGML_METAL_EMBED_LIBRARY ON CACHE BOOL "" FORCE)
else()
    set(GGML_METAL OFF CACHE BOOL "" FORCE)
    set(GGML_METAL_EMBED_LIBRARY OFF CACHE BOOL "" FORCE)
endif()
foreach(backend CUDA VULKAN RPC HIP SYCL OPENCL OPENVINO WEBGPU ZDNN VIRTGPU MUSA HEXAGON)
    set(GGML_${backend} OFF CACHE BOOL "" FORCE)
endforeach()
if(WIN32)
    # Only the Windows dispatcher may select kernels requiring these instructions.
    foreach(isa SSE42 AVX AVX2 AVX_VNNI BMI2 AVX512 AVX512_VBMI AVX512_VNNI AVX512_BF16 FMA F16C AMX_TILE AMX_INT8 AMX_BF16)
        set(GGML_${isa} OFF CACHE BOOL "" FORCE)
    endforeach()
endif()
foreach(component COMMON TESTS TOOLS EXAMPLES SERVER APP UI MTMD)
    set(LLAMA_BUILD_${component} OFF CACHE BOOL "" FORCE)
endforeach()
add_subdirectory("${opt_llama_source}" third_party/llama EXCLUDE_FROM_ALL)

if(opt_windows_kernels)
    include("${CMAKE_CURRENT_LIST_DIR}/WindowsCpuKernels.cmake")
    target_sources(opt_inference PRIVATE src/platform/windows/inference_backend.cpp)
else()
    target_sources(opt_inference PRIVATE src/inference/upstream_backend.cpp)
endif()
